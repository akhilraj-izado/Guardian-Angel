@{
    ViewData["Title"] = "Guardian Angel Retirement Home";
}

<!-- ================= RETIREMENT HOME HERO SECTION ================= -->
<section class="relative bg-white min-h-[75vh] lg:min-h-[85vh] flex items-center overflow-hidden">

    <!-- Desktop / Tablet Background Image -->
    <div class="hidden md:block absolute inset-0 bg-cover bg-center lg:bg-right-bottom bg-no-repeat"
         style="background-image: url('/images/Sunlit-Pink-Building-Courtyar.png');"
         data-aos="fade-left"
         data-aos-duration="1200"></div>

    <!-- Soft White & Sunlight Gradient Overlay for Seamless Text Readability -->
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white via-white/40 via-40% to-transparent pointer-events-none"></div>

    <!-- Mobile Top Image -->
    <div class="md:hidden w-full" data-aos="fade-down" data-aos-duration="800">
        <img src="/images/Sunlit-Pink-Building-Courtyar.png"
             alt="Guardian Angel Retirement Home, Airapuram"
             class="w-full h-auto object-cover max-h-[380px]" />
    </div>

    <!-- Content Container -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-12 md:py-24 lg:py-32 w-full z-10">
        <div class="w-full md:w-[55%] lg:w-[46%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <!-- Main Heading in Cormorant Garamond -->
            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wider text-navy leading-[1.2] mb-5">
                Guardian Angel<br />
                Retirement Home, Airapuram
            </h1>

            <!-- Description Paragraph in Lato Font -->
            <p class="font-lato text-xs sm:text-sm md:text-[15px] text-[#1E1E1E]/90 leading-relaxed max-w-xl">
                The Guardian Angel Retirement Home, Airapuram, is one of the pioneering humanitarian initiatives established under the visionary leadership of His Eminence Dr. Abraham Mar Severios Metropolitan.
            </p>

        </div>
    </div>
</section>
<!-- ================= OUR STORY & HISTORICAL BACKGROUND SECTION ================= -->
<section class="relative bg-[#f7f5ed] bg-cover bg-top bg-no-repeat py-16 sm:py-20 lg:py-28 overflow-hidden"
         style="background-image: url('/images/Chapel Garden Heritage Background.png');">

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 z-10">

        <!-- ================= TOP SECTION: OUR STORY ================= -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-20 sm:mb-28 lg:mb-36">

            <!-- Spacer for Desktop to let the Stone Chapel show on Left -->
            <div class="hidden lg:block lg:col-span-6 xl:col-span-7"></div>

            <!-- Right Column: Our Story Content -->
            <div class="lg:col-span-6 xl:col-span-5 bg-white/70 lg:bg-transparent backdrop-blur-sm lg:backdrop-blur-none p-6 sm:p-8 lg:p-0 rounded-2xl lg:rounded-none shadow-sm lg:shadow-none"
                 data-aos="fade-left"
                 data-aos-duration="900">

                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold uppercase tracking-wider text-navy leading-tight mb-4">
                    Our Story
                </h2>

                <p class="font-lato text-xs sm:text-sm md:text-[15px] text-[#1E1E1E]/90 leading-relaxed">
                    Founded with the noble objective of ensuring dignified, peaceful, and compassionate living for elderly individuals, the institution has served as a sanctuary of care and companionship for senior citizens for more than four decades.
                </p>

            </div>
        </div>

        <!-- ================= BOTTOM SECTION: HISTORICAL BACKGROUND & TIMELINE ================= -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start pt-6 sm:pt-10">

            <!-- Left Column: Historical Background Text -->
            <div class="lg:col-span-6 space-y-5 bg-white/70 lg:bg-transparent backdrop-blur-sm lg:backdrop-blur-none p-6 sm:p-8 lg:p-0 rounded-2xl lg:rounded-none shadow-sm lg:shadow-none"
                 data-aos="fade-right"
                 data-aos-duration="900">

                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl font-bold uppercase tracking-wider text-navy leading-tight mb-4">
                    Historical Background
                </h2>

                <div class="font-lato space-y-4 text-xs sm:text-sm md:text-[14px] text-[#1E1E1E]/90 leading-relaxed text-justify sm:text-left">
                    <p>
                        With the support of the late Reverend P.U. Mathai, Peringattu, His Eminence Dr. Abraham Mar Severios Metropolitan acquired land at Airapuram, a serene village in Ernakulam District, Kerala, for establishing a residential home for the elderly. At a time when institutional elder care was not widely accepted in society, the Bishop foresaw the growing need for a safe and caring environment where senior citizens could live with dignity, emotional security, and spiritual support.
                    </p>

                    <p>
                        The property for the retirement home was purchased from the estate of the late Punnasheril P.M. Thomas. A modest shed was initially constructed on the land, where Mr. M.M. Chacko, a retired employee of the Madras Port Trust, resided & assisted in the early developmental activities of the institution. Inspired by the Bishop's vision to establish a chapel within the campus, a public meeting was convened at the residence of the late Shri P.M. Issac, Punnasheril. Under the leadership of the late Reverend K.M. Joseph, Kannathumollel, a committee comprising local residents was formed with the late Reverend P.U. Mathai & Shri P.U. Poulose, Peringattu, serving as conveners.
                    </p>
                </div>

            </div>

            <!-- Right Column: Golden Timeline -->
            <div class="lg:col-span-6 bg-white/70 lg:bg-transparent backdrop-blur-sm lg:backdrop-blur-none p-6 sm:p-8 lg:p-0 rounded-2xl lg:rounded-none shadow-sm lg:shadow-none"
                 data-aos="fade-left"
                 data-aos-duration="900"
                 data-aos-delay="150">

                <div class="relative pl-6 sm:pl-8 space-y-10 sm:space-y-12 before:absolute before:left-3 sm:before:left-3.5 before:top-2 before:bottom-3 before:w-[2px] before:bg-[#D5A852]">

                    <!-- Timeline Item 1: 1983 -->
                    <div class="relative flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-6 group">
                        <!-- Bullet Point -->
                        <div class="absolute -left-[19px] sm:-left-[21px] top-1.5 w-5 h-5 rounded-full bg-[#D5A852] border-4 border-[#f7f5ed] shadow-sm shrink-0"></div>

                        <!-- Year -->
                        <div class="shrink-0 pt-0.5 sm:w-20">
                            <span class="font-cormorant text-2xl sm:text-3xl font-bold text-[#C89438] tracking-tight leading-none">
                                1983
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="flex-1">
                            <p class="font-lato text-xs sm:text-[13px] text-[#1E1E1E]/85 leading-relaxed">
                                With the wholehearted support of the local community, St. Mary's Chapel was constructed & consecrated on April 15, 1983, by His Grace Baselios Augen I, the then Catholicos of the East, in the presence of His Grace Thomas Mar Dionysius.
                            </p>
                        </div>
                    </div>

                    <!-- Timeline Item 2: 1984 -->
                    <div class="relative flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-6 group">
                        <!-- Bullet Point -->
                        <div class="absolute -left-[19px] sm:-left-[21px] top-1.5 w-5 h-5 rounded-full bg-[#D5A852] border-4 border-[#f7f5ed] shadow-sm shrink-0"></div>

                        <!-- Year -->
                        <div class="shrink-0 pt-0.5 sm:w-20">
                            <span class="font-cormorant text-2xl sm:text-3xl font-bold text-[#C89438] tracking-tight leading-none">
                                1984
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="flex-1">
                            <p class="font-lato text-xs sm:text-[13px] text-[#1E1E1E]/85 leading-relaxed">
                                Following months of dedicated effort, the Guardian Angel Retirement Home was formally inaugurated on October 21, 1984, by the then Governor of Kerala, Shri P. Ramachandran. The occasion was blessed by the presence of His Beatitude Baselios Paulose II and His Grace Thomas Mar Dionysius. The spiritual life of the institution continued to flourish through the dedicated service of several priests.
                            </p>
                        </div>
                    </div>

                    <!-- Timeline Item 3: 1997 -->
                    <div class="relative flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-6 group">
                        <!-- Bullet Point -->
                        <div class="absolute -left-[19px] sm:-left-[21px] top-1.5 w-5 h-5 rounded-full bg-[#D5A852] border-4 border-[#f7f5ed] shadow-sm shrink-0"></div>

                        <!-- Year -->
                        <div class="shrink-0 pt-0.5 sm:w-20">
                            <span class="font-cormorant text-2xl sm:text-3xl font-bold text-[#C89438] tracking-tight leading-none">
                                1997
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="flex-1">
                            <p class="font-lato text-xs sm:text-[13px] text-[#1E1E1E]/85 leading-relaxed">
                                Later, Mar Augen Chapel was constructed within the campus, with its foundation stone laid on August 15, 1997, and consecrated on April 12, 1998. Since 2015, Reverend Father Jijo has been serving as the Vicar and Administrator of the Home.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>
</section>
<!-- ================= SECTION 1: MISSION AND CARE (LEFT EDGE FULL BLEED) ================= -->
<section class="bg-white py-16 sm:py-20 lg:py-24 overflow-hidden">
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Image: Full Left Screen Bleed with Right Arch Curve -->
        <div class="w-full lg:w-[48%] xl:w-[46%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 lg:h-[460px] rounded-r-[120px] sm:rounded-r-[180px] lg:rounded-r-[220px] overflow-hidden shadow-lg bg-gray-50">
                <img src="/images/Sunlit Blue-Trimmed Church Courtyard.png"
                     alt="Mission and Care - Guardian Angel Retirement Home"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column: Proper Padding & Alignment -->
        <div class="w-full lg:w-[52%] xl:w-[54%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-24" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold uppercase tracking-wider text-navy leading-tight mb-5">
                    Mission and Care
                </h2>

                <div class="font-lato space-y-4 text-xs sm:text-sm md:text-[15px] text-[#1E1E1E]/90 leading-relaxed text-justify sm:text-left">
                    <p>
                        Guardian Angel Retirement Home was established with the mission of providing compassionate residential care to elderly individuals irrespective of caste, creed, religion, or social background. The Home offers a peaceful and supportive environment where residents experience comfort, companionship, healthcare support, and spiritual care.
                    </p>

                    <p>
                        In today's social context, where many elderly parents experience loneliness due to migration of family members for employment & business, the institution serves as a reassuring presence and a caring community. Both short-term and long-term residential facilities are available, with individualized attention provided according to the health conditions and personal needs of each resident[cite: 31].
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ================= SECTION 2: OUR FACILITIES (#FAF0DE BACKGROUND) ================= -->
<section class="bg-[#FAF0DE] py-16 sm:py-20 lg:py-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">

        <!-- Heading -->
        <div class="mb-10 sm:mb-12" data-aos="fade-up" data-aos-duration="800">
            <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl font-bold uppercase tracking-wider text-navy leading-tight">
                Our Facilities
            </h2>
        </div>

        <!-- 4 Facilities Grid Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7 items-start">

            <!-- Facility 1: Comfortable Accommodation -->
            <div class="flex flex-col group" data-aos="fade-up" data-aos-delay="100">
                <div class="w-full h-56 sm:h-64 rounded-3xl overflow-hidden shadow-sm border border-black/5 mb-5 bg-white">
                    <img src="/images/Bright Organized Dormitory Study Room.png"
                         alt="Comfortable Accommodation"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <h3 class="font-cormorant text-lg sm:text-xl font-bold text-navy leading-snug mb-2.5">
                    Comfortable Accommodation
                </h3>
                <p class="font-lato text-xs sm:text-sm text-[#1E1E1E]/85 leading-relaxed">
                    The Home provides comfortable and independent residential accommodation through 16 spacious bath-attached rooms designed to suit elderly individuals as well as couples[cite: 25].
                </p>
            </div>

            <!-- Facility 2: Nutritious Meal -->
            <div class="flex flex-col group" data-aos="fade-up" data-aos-delay="200">
                <div class="w-full h-56 sm:h-64 rounded-3xl overflow-hidden shadow-sm border border-black/5 mb-5 bg-white">
                    <img src="/images/easy-flexitarian-diet-food-assortment.jpg"
                         alt="Nutritious Meal"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <h3 class="font-cormorant text-lg sm:text-xl font-bold text-navy leading-snug mb-2.5">
                    Nutritious Meal
                </h3>
                <p class="font-lato text-xs sm:text-sm text-[#1E1E1E]/85 leading-relaxed">
                    Nutritious and hygienically prepared meals are provided through an in-house kitchen facility, ensuring quality food suited to the dietary needs and health conditions of senior citizens[cite: 25].
                </p>
            </div>

            <!-- Facility 3: Peaceful Environment -->
            <div class="flex flex-col group" data-aos="fade-up" data-aos-delay="300">
                <div class="w-full h-56 sm:h-64 rounded-3xl overflow-hidden shadow-sm border border-black/5 mb-5 bg-white">
                    <img src="/images/Bright Organized Dormitory Study Room.png"
                         alt="Peaceful Environment"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <h3 class="font-cormorant text-lg sm:text-xl font-bold text-navy leading-snug mb-2.5">
                    Peaceful Environment
                </h3>
                <p class="font-lato text-xs sm:text-sm text-[#1E1E1E]/85 leading-relaxed">
                    The rooms are planned to ensure privacy, safety, comfort, and ease of accessibility, enabling residents to enjoy a peaceful and dignified living environment[cite: 25]
                </p>
            </div>

            <!-- Facility 4: Safety & Accessibility -->
            <div class="flex flex-col group" data-aos="fade-up" data-aos-delay="400">
                <div class="w-full h-56 sm:h-64 rounded-3xl overflow-hidden shadow-sm border border-black/5 mb-5 bg-white">
                    <img src="/images/Serene Senior Living Courtyard Community.png"
                         alt="Safety & Accessibility"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <h3 class="font-cormorant text-lg sm:text-xl font-bold text-navy leading-snug mb-2.5">
                    Safety &amp; Accessibility
                </h3>
                <p class="font-lato text-xs sm:text-sm text-[#1E1E1E]/85 leading-relaxed">
                    The campus is designed to ensure safety, accessibility, and comfort for senior citizens, with facilities including accessible living spaces, recreation areas, reading facilities, prayer spaces, and senior-friendly infrastructure[cite: 25].
                </p>
            </div>

        </div>

    </div>
</section>
<!-- ================= SECTION 1: HEALTHCARE AND WELLNESS (RIGHT BLEED & LEFT ARCH CURVE) ================= -->
<section class="bg-white py-16 sm:py-20 lg:py-24 overflow-hidden">
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[50%] xl:w-[48%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Healthcare and Wellness
                </h2>

                <div class="font-lato space-y-4 text-xs sm:text-sm md:text-[14px] text-[#1E1E1E]/90 leading-relaxed text-justify sm:text-left">
                    <p>
                        Healthcare and emotional well-being remain integral aspects of the institution's service. Residents receive regular medical attention and healthcare support through visiting doctors, nurses, and healthcare workers[cite: 32]. Wellness programs, health awareness sessions, and simple physical exercise activities are regularly conducted to promote healthy and active aging[cite: 32].
                    </p>

                    <p>
                        The Home also encourages meaningful social engagement through recreational activities, fellowship gatherings, gardening, cultural programs, festive celebrations, and occasional outings[cite: 32]. These initiatives help foster a sense of belonging, emotional fulfillment, and community life among the residents[cite: 32].
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Image: Full Right Screen Bleed with Left Arch Curve -->
        <div class="w-full lg:w-[50%] xl:w-[52%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 lg:h-[460px] rounded-l-[120px] sm:rounded-l-[180px] lg:rounded-l-[230px] rounded-r-none overflow-hidden shadow-lg bg-gray-50">
                <img src="/images/you-have-heartbeat-like-young-man.jpg"
                     alt="Healthcare and Wellness"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>
</section>

<!-- ================= SECTION 2: CONTINUING LEGACY (LEFT BLEED & RIGHT ARCH CURVE) ================= -->
<section class="bg-white py-16 sm:py-20 lg:py-24 overflow-hidden">
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Image: Full Left Screen Bleed with Right Arch Curve -->
        <div class="w-full lg:w-[50%] xl:w-[52%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 lg:h-[460px] rounded-r-[120px] sm:rounded-r-[180px] lg:rounded-r-[230px] rounded-l-none overflow-hidden shadow-lg bg-gray-50">
                <img src="/images/united-hands-business-team.jpg"
                     alt="Continuing Legacy"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[50%] xl:w-[48%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Continuing Legacy
                </h2>

                <div class="font-lato space-y-4 text-xs sm:text-sm md:text-[14px] text-[#1E1E1E]/90 leading-relaxed text-justify sm:text-left">
                    <p>
                        Over the years, the Guardian Angel Retirement Home has earned deep appreciation for its compassionate service and commitment to elderly care[cite: 32]. Rooted in the visionary ideals of His Eminence Dr. Abraham Mar Severios Metropolitan, the institution continues to uphold its mission of offering elderly individuals not merely a place to stay, but a life of dignity, peace, security, and hope within a caring community environment[cite: 32].
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>