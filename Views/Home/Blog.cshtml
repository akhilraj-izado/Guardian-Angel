@{
    ViewData["Title"] = "Blog";
}

<!-- ================= BLOG PAGE HERO SECTION ================= -->
<section class="relative bg-[#F9F5EE] overflow-hidden md:min-h-[80vh] flex flex-col justify-center">
  <div 
    class="hidden md:block absolute inset-0 bg-cover bg-right bg-no-repeat"
    style="background-image: url('/images/blog-hero-bg.png');"
  ></div>

  <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-[#F9F5EE] via-[#F9F5EE]/85 to-transparent"></div>

  <img 
    src="/images/blog-hero-bg.png" 
    alt="Notebook with coffee cup" 
    class="md:hidden w-full h-auto object-cover max-h-[300px]"
  />

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-12 md:py-16 w-full flex items-center">
    <div class="w-full md:w-[60%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900">
      <p class="font-cormorant text-sm sm:text-base font-bold uppercase tracking-[0.25em] text-sky">
        Our <span class="text-navy">Blog</span>
      </p>

      <h1 class="font-cormorant mt-2 text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wide text-navy leading-[1.2]">
        Stories of Hope, Faith &amp;<br />Compassion
      </h1>

      <div class="font-lato mt-5 space-y-4 text-[#1E1E1E] text-xs sm:text-sm md:text-base leading-relaxed max-w-xl">
        <p>
          Discover inspiring stories, community updates, and moments of service that reflect our mission of bringing hope, healing, and dignity to every life we touch.
        </p>
        <p>
          Stay updated with our latest news, events, and inspiring stories.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ================= BLOG LISTING & SIDEBAR SECTION ================= -->
<section class="py-12 md:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">

    <!-- Top Filter Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 md:mb-12" data-aos="fade-down" data-aos-duration="800">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3" id="blog-tabs">
        <button onclick="switchTab('all')" data-tab="all" class="tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all bg-sky text-white shadow-sm">
          All Blogs
        </button>
        <button onclick="switchTab('stories')" data-tab="stories" class="tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          Stories
        </button>
        <button onclick="switchTab('news')" data-tab="news" class="tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          News &amp; Events
        </button>
        <button onclick="switchTab('updates')" data-tab="updates" class="tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          Updates
        </button>
        <button onclick="switchTab('inspiration')" data-tab="inspiration" class="tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          Inspiration
        </button>
      </div>

      <div class="relative w-full md:w-72 lg:w-80">
        <input 
          type="text" 
          id="blog-search" 
          onkeyup="filterBlogs()" 
          placeholder="Search Blogs" 
          class="w-full pl-5 pr-11 py-2.5 rounded-full border border-gray-300 text-xs sm:text-sm focus:outline-none focus:border-sky font-lato"
        />
        <svg class="w-4 h-4 text-gray-500 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">

      <!-- Left Column: Posts List -->
      <div class="lg:col-span-8 flex flex-col justify-between">
        <div id="blog-cards-container" class="space-y-6">

          <!-- Card 1 -->
          <article class="blog-card bg-white rounded-2xl border border-sky/30 shadow-sm p-3.5 sm:p-4 flex flex-col sm:flex-row gap-5 items-stretch" data-category="stories" data-aos="fade-up" data-aos-delay="100">
            <div class="sm:w-[42%] h-52 sm:h-auto rounded-xl overflow-hidden shrink-0">
              <img src="/images/blog-img-1.png" alt="A Life Filled with Gratitude and New Beginnings" class="w-full h-full object-cover" />
            </div>
            <div class="sm:w-[58%] flex flex-col justify-between py-1">
              <div>
                <span class="font-cormorant text-xs sm:text-sm font-bold uppercase tracking-wider text-amber-600 block">STORIES</span>
                <h3 class="font-cormorant text-xl sm:text-2xl font-bold text-navy mt-1 leading-snug">
                  A Life Filled with Gratitude and New Beginnings
                </h3>
                <p class="font-lato mt-2 text-xs sm:text-sm text-gray-600 leading-relaxed">
                  Meet Leelamma, a resident of our Retirement Home, whose journey is a beautiful reminder that it's never too late for a new beginning.
                </p>
              </div>
              <div class="mt-4 pt-3 flex items-center justify-between border-t border-gray-100">
                <div class="flex items-center gap-4 text-xs text-gray-500 font-lato">
                  <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-sky" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> May 12, 2025</span>
                  <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-sky" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> 6 min</span>
                </div>
                <a href="#" class="font-lato rounded-full border border-navy/70 text-navy px-4 py-1 text-xs font-semibold hover:bg-navy hover:text-white transition-colors">Read More</a>
              </div>
            </div>
          </article>

          <!-- Card 2 -->
          <article class="blog-card bg-white rounded-2xl border border-sky/30 shadow-sm p-3.5 sm:p-4 flex flex-col sm:flex-row gap-5 items-stretch" data-category="news" data-aos="fade-up" data-aos-delay="200">
            <div class="sm:w-[42%] h-52 sm:h-auto rounded-xl overflow-hidden shrink-0">
              <img src="/images/blog-img-2.png" alt="Annual Day Celebration at Bethesda Schools" class="w-full h-full object-cover" />
            </div>
            <div class="sm:w-[58%] flex flex-col justify-between py-1">
              <div>
                <span class="font-cormorant text-xs sm:text-sm font-bold uppercase tracking-wider text-amber-600 block">NEWS &amp; EVENTS</span>
                <h3 class="font-cormorant text-xl sm:text-2xl font-bold text-navy mt-1 leading-snug">
                  Annual Day Celebration at Bethesda Schools
                </h3>
                <p class="font-lato mt-2 text-xs sm:text-sm text-gray-600 leading-relaxed">
                  A day filled with joy, performances, and proud moments as our students showcased their talents and spirit.
                </p>
              </div>
              <div class="mt-4 pt-3 flex items-center justify-between border-t border-gray-100">
                <div class="flex items-center gap-4 text-xs text-gray-500 font-lato">
                  <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-sky" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> May 12, 2025</span>
                  <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-sky" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> 6 min</span>
