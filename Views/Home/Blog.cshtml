<!-- ================= STAY CONNECTED / NEWSLETTER SECTION ================= -->
<section class="relative bg-[#FBF5EC] overflow-hidden py-14 sm:py-16 md:py-20" data-aos="fade-in" data-aos-duration="900">
  <div 
    class="hidden md:block absolute inset-0 bg-cover bg-right bg-no-repeat"
    style="background-image: url('/images/subscribe-bg.png');"
  ></div>

  <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-[#FBF5EC] via-[#FBF5EC]/85 to-transparent"></div>

  <img 
    src="/images/subscribe-bg.png" 
    alt="Desk with open book, coffee and plant vase" 
    class="md:hidden w-full h-auto object-cover max-h-[260px] mb-6"
  />

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    <div class="w-full md:w-[60%] lg:w-[50%]" data-aos="fade-right" data-aos-delay="150">
      <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl font-bold uppercase tracking-[0.12em] text-navy leading-tight">
        Stay Connected
      </h2>

      <p class="font-lato mt-3 text-xs sm:text-sm md:text-[15px] leading-relaxed text-[#1E1E1E]/90 max-w-md">
        Subscribe to our newsletter and stay updated with our latest stories and activities.
      </p>

      <form class="mt-8 flex items-center bg-[#FBF5EC] sm:bg-[#FAF3E7] rounded-full border border-sky/70 p-1.5 sm:p-2 shadow-sm focus-within:border-sky focus-within:ring-2 focus-within:ring-sky/20 transition-all max-w-lg">
        <input 
          type="email" 
          placeholder="Enter your email address" 
          required
          class="font-lato w-full bg-transparent px-4 sm:px-5 py-2 text-xs sm:text-sm text-[#1E1E1E] placeholder:text-gray-500 focus:outline-none"
        />
        <button 
          type="submit" 
          class="font-lato inline-flex items-center justify-center gap-2 bg-navy hover:bg-[#121f42] text-white px-5 sm:px-7 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-colors shrink-0 shadow-sm"
        >
          <span>Subscribe</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

@section Scripts {
<script>
  let currentTab = 'all';
  let currentPage = 1;

  function switchTab(category) {
    currentTab = category;
    
    document.querySelectorAll('.tab-btn').forEach(btn => {
      if (btn.dataset.tab === category) {
        btn.className = "tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all bg-sky text-white shadow-sm";
      } else {
        btn.className = "tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky";
      }
    });

    filterBlogs();
  }

  function filterBlogs() {
    const query = document.getElementById('blog-search').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.blog-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const cardCat = card.dataset.category;
      const cardText = card.innerText.toLowerCase();

      const matchesTab = (currentTab === 'all' || cardCat === currentTab);
      const matchesSearch = cardText.includes(query);

      if (matchesTab && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const noResultMsg = document.getElementById('no-results-msg');
    if (noResultMsg) {
      if (visibleCount === 0) {
        noResultMsg.classList.remove('hidden');
      } else {
        noResultMsg.classList.add('hidden');
      }
    }

    // Refresh AOS positions after filtering
    if (typeof AOS !== 'undefined') {
      AOS.refresh();
    }
  }

  function changePage(page) {
    if (page < 1 || page > 10) return;
    currentPage = page;

    document.querySelectorAll('.page-num').forEach(btn => {
      if (parseInt(btn.innerText) === page) {
        btn.className = "page-num font-lato w-8 h-8 rounded-full text-xs font-bold transition-all bg-sky text-white flex items-center justify-center";
      } else {
        btn.className = "page-num font-lato w-8 h-8 rounded-full text-xs font-bold transition-all text-navy hover:bg-gray-100 flex items-center justify-center";
      }
    });

    const tabsElement = document.getElementById('blog-tabs');
    if (tabsElement) {
      tabsElement.scrollIntoView({ behavior: 'smooth' });
    }
  }
</script>
}
