@{
    ViewData["Title"] = "Bethsada Geriatric Destitute Home";
}

<!-- ================= BETHSADA GERIATRIC DESTITUTE HOME HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[85vh] flex items-center overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div class="absolute inset-0 bg-cover bg-center lg:bg-right-bottom bg-no-repeat"
         style="background-image: url('/images/Serene Chapel Entrance in Blooming Greenery.png');"
         role="img" aria-label="Bethsada Geriatric Destitute Home, Vengola"
         data-aos="fade-left"
         data-aos-duration="1200"></div>

    <!-- White Gradient Overlay for Text Readability (stronger on mobile where text spans full width) -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 md:from-white/95 md:from-20% md:via-white/75 md:via-45% md:to-transparent md:to-60% pointer-events-none"></div>

    <!-- Main Content Container -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-16 md:py-24 lg:py-32 w-full z-10">
        <div class="w-full md:w-[56%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <!-- Main Heading in Cormorant Garamond Font -->
            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wider text-navy leading-[1.2] mb-5">
                Bethsada Geriatric<br />
                Destitute Home, Vengola
            </h1>

            <!-- Description Paragraph in Lato Font -->
            <p class="font-lato text-sm md:text-[14.5px] text-[#1E1E1E]/90 leading-relaxed max-w-xl text-justify sm:text-left">
                Bethsada Old Age Destitute Home, Vengola, was established in the year 1992 with the mission of providing care, protection, and dignity to homeless and destitute elderly individuals, particularly those who have been neglected, abandoned, or left without family support. The institution was founded in response to the difficult living conditions faced by vulnerable elders who struggled to access even basic necessities such as food, shelter, healthcare, and emotional care.
            </p>

        </div>
    </div>

</section>
<!-- ================= VALUES, CHALLENGES & CARE SECTION (#FAF0DE) ================= -->
<section class="bg-[#FAF0DE] py-12 sm:py-20 lg:py-28 overflow-hidden space-y-14 sm:space-y-20 lg:space-y-28">

    <!-- ================= BLOCK 1: OUR VALUES (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Our Values
                </h2>
                <p class="font-lato text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    Guided by the values of compassion, dignity, empathy, and social responsibility, the home strives to create a safe and family-like environment where every resident feels respected, valued, and emotionally supported. The institution believes that every elderly person deserves a secure and peaceful life irrespective of their personal or social circumstances.
                </p>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-l-[130px] sm:rounded-l-[190px] lg:rounded-l-[250px] rounded-r-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Intergenerational Chess in the Garden.png"
                     alt="Our Values - Intergenerational Chess"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: OVERCOMING CHALLENGES (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-16">

        <!-- Left Image: Bleeds to Left Screen Edge with Right Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-r-[130px] sm:rounded-r-[190px] lg:rounded-r-[250px] rounded-l-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Sunlit Tropical Church Courtyard.png"
                     alt="Overcoming Challenges - Church Courtyard"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28 shrink-0" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Overcoming Challenges
                </h2>

                <div class="font-lato space-y-4 text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        The establishment of the home involved several challenges, including limited financial resources, infrastructure development, and the need to provide adequate healthcare and daily support services.
                    </p>
                    <p>
                        Through the support of well-wishers, local community members, charitable organizations, volunteers, and social workers, these difficulties were gradually overcome. Community participation and sustained encouragement continue to play a vital role in strengthening the institution and ensuring the continuity of its services.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 3: OUR CARE & SUPPORT (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Our Care &amp; Support
                </h2>

                <div class="font-lato space-y-4 text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        The establishment of the home involved several challenges, including limited financial resources, infrastructure development, and the need to provide adequate healthcare and daily support services.
                    </p>
                    <p>
                        Through the support of well-wishers, local community members, charitable organizations, volunteers, and social workers, these difficulties were gradually overcome. Community participation and sustained encouragement continue to play a vital role in strengthening the institution and ensuring the continuity of its services.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-l-[130px] sm:rounded-l-[190px] lg:rounded-l-[250px] rounded-r-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Community Volunteers Delivering Supplies.png"
                     alt="Our Care and Support - Volunteers Delivering Supplies"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

</section>