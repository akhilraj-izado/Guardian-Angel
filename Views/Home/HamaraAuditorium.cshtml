@{
    ViewData["Title"] = "Hamara Auditorium";
}

<!-- ================= MAR GABRIEL PRAYER TOWER HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[88vh] overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"
         style="background-image: url('/images/mar-gabriel-prayer-tower-hero.png');"
         role="img" aria-label="Hamara Auditorium campus, Vengola"
         data-aos="fade-in"
         data-aos-duration="1200"></div>

    <!-- White wash for readability: stronger on mobile (text spans full width), soft on the left for desktop -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/70 to-white/30 md:from-white/50 md:via-white/15 md:to-transparent pointer-events-none"></div>

    <!-- Main Content (sits in the upper-left, below the overlay header) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-14 pb-20 sm:pt-16 sm:pb-24 md:pt-36 lg:pt-44 md:pb-24">
        <div class="w-full md:w-[55%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[44px] font-semibold uppercase tracking-wide text-navy leading-[1.25]">
                Hamara Auditorium,<br />
                Vengola
            </h1>

            <p class="font-lato mt-4 md:mt-5 text-sm sm:text-[15px] md:text-base text-[#4A5568] leading-relaxed max-w-xl">
                Hamara Auditorium, situated within the campus of Bethsada Public School, Vengola, is a modern and well-equipped venue designed to serve both the educational community and the general public.
            </p>

        </div>
    </div>

</section>

<!-- ================= LEARNING, CULTURE & COMMUNITY (CURVED IMAGE BLOCKS) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 lg:py-24 overflow-hidden space-y-14 lg:space-y-16">

    <!-- ================= BLOCK 1: A SPACE FOR LEARNING, CULTURE AND COMMUNITY (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[52%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                    A space for learning, culture<br class="hidden lg:block" />
                    and community
                </h2>
                <p class="font-lato text-sm sm:text-[15px] text-[#5E6B7A] leading-relaxed">
                    Established with the vision of creating a quality space for academic, cultural, and social events, the auditorium has become one of the preferred venues in the region.
                </p>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
        <div class="w-full lg:w-[48%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-60 sm:h-80 md:h-[340px] lg:h-[330px] rounded-l-full overflow-hidden">
                <img src="/images/hamara-auditorium-stage.png"
                     alt="Hamara Auditorium stage with blue curtains and rows of seating"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: SCHOOL & WIDER COMMUNITY (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
        <div class="w-full lg:w-[48%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-60 sm:h-80 md:h-[340px] lg:h-[330px] rounded-r-full overflow-hidden">
                <img src="/images/hamara-auditorium-school-event.png"
                     alt="Students attending a school event in Hamara Auditorium"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[52%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl space-y-8 lg:space-y-10">

                <div>
                    <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                        For the school community
                    </h2>
                    <p class="font-lato text-sm sm:text-[15px] text-[#5E6B7A] leading-relaxed">
                        The auditorium plays an important role in the life of the school by hosting assemblies, seminars, workshops, annual celebrations, training programmes, and cultural events that enrich the learning experience of students.
                    </p>
                </div>

                <div>
                    <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                        For the wider community
                    </h2>
                    <p class="font-lato text-sm sm:text-[15px] text-[#5E6B7A] leading-relaxed">
                        At the same time, it serves the wider community by providing a spacious, accessible, and welcoming venue for public meetings, cultural programmes, weddings, receptions, and family gatherings.
                    </p>
                </div>

            </div>
        </div>

    </div>

</section>

<!-- ================= EVENTS WE HOST (6 ICONS) ================= -->
<section class="bg-white py-12 sm:py-14 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10" data-aos="fade-up" data-aos-duration="900">
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-10 items-start">

            <li class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-3">
                    <img src="/images/icon-ha-assemblies.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                </div>
                <span class="font-lato text-sm sm:text-[15px] text-navy leading-snug">Assemblies</span>
            </li>

            <li class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-3">
                    <img src="/images/icon-ha-seminars-workshops.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                </div>
                <span class="font-lato text-sm sm:text-[15px] text-navy leading-snug">Seminars &amp; Workshops</span>
            </li>

            <li class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-3">
                    <img src="/images/icon-ha-annual-celebrations.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                </div>
                <span class="font-lato text-sm sm:text-[15px] text-navy leading-snug">Annual Celebrations</span>
            </li>

            <li class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-3">
                    <img src="/images/icon-ha-cultural-events.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                </div>
                <span class="font-lato text-sm sm:text-[15px] text-navy leading-snug">Cultural Events</span>
            </li>

            <li class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-3">
                    <img src="/images/icon-ha-weddings-receptions.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                </div>
                <span class="font-lato text-sm sm:text-[15px] text-navy leading-snug">Weddings &amp; Receptions</span>
            </li>

            <li class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-3">
                    <img src="/images/icon-ha-public-meetings.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                </div>
                <span class="font-lato text-sm sm:text-[15px] text-navy leading-snug">Public Meetings</span>
            </li>

        </ul>
    </div>
</section>

<!-- ================= BUILT WITH PURPOSE & COMMUNITY SUPPORT (RIGHT BLEED, LEFT CURVE) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 overflow-hidden">
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-24" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[44px] font-semibold text-navy leading-[1.25] mb-5">
                    Built with purpose<br class="hidden sm:block" />
                    &amp; community support
                </h2>
                <div class="font-lato space-y-1 text-sm sm:text-[15px] md:text-[17px] text-[#5E6B7A] leading-relaxed">
                    <p>
                        Hamara Auditorium was developed through the dedicated efforts of the management of Guardian Angel Care Charitable Society and Bethsada Public School, with valuable support from well-wishers and the local community. Built with a commitment to inclusivity, accessibility, and community development, the facility combines modern amenities with a warm and service-oriented atmosphere.
                    </p>
                    <p>
                        Today, Hamara Auditorium stands as a vibrant centre for education, culture, and community engagement, strengthening the bond between the institution and society while supporting a wide range of meaningful events throughout the year.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
        <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[380px] lg:h-[360px] xl:h-[380px] rounded-l-full overflow-hidden">
                <img src="/images/hamara-auditorium-building.png"
                     alt="Hamara Auditorium building entrance at sunset"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>
</section>

