@{
    ViewData["Title"] = "The Hermits";
}

<!-- ================= THE HERMITS HERO SECTION ================= -->
<section class="relative bg-white md:min-h-[75vh] lg:min-h-[88vh] overflow-hidden">

    <!-- Desktop / Tablet Background Image -->
    <div class="hidden md:block absolute inset-0 bg-cover bg-top bg-no-repeat"
         style="background-image: url('/images/hermits-hero.png');"
         data-aos="fade-in"
         data-aos-duration="1200"></div>

    <!-- Soft light wash on the right so the heading stays readable over the sky -->
    <div class="hidden md:block absolute inset-0 bg-gradient-to-l from-white/50 via-white/15 to-transparent pointer-events-none"></div>

    <!-- Mobile Top Image -->
    <img src="/images/hermits-hero.png"
         alt="Entrance gate of The Hermits, Kolpara, Illithode"
         class="md:hidden w-full h-auto object-cover" />

    <!-- Main Content (sits in the upper-right, below the overlay header) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-8 pb-12 md:pt-36 lg:pt-44 md:pb-24 flex md:justify-end">
        <div class="w-full md:w-[45%] lg:w-[40%]" data-aos="fade-left" data-aos-duration="900" data-aos-delay="200">

            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[44px] font-semibold uppercase tracking-wide text-navy leading-[1.25]">
                The Hermits:<br />
                A Sanctuary for<br class="hidden sm:block" />
                Spiritual Renewal
            </h1>

            <p class="font-lato mt-4 md:mt-5 text-sm sm:text-[15px] md:text-base text-[#4A5568] leading-relaxed max-w-xl">
                Nestled atop the serene hills of Illithode, The Hermits is the newest initiative of the Guardian Angel Care Charitable Society, envisioned as a sacred space for meditation, prayer, and spiritual renewal.
            </p>

        </div>
    </div>

</section>

<!-- ================= NATURE & COMMUNITY (CURVED IMAGE BLOCKS) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 lg:py-24 overflow-hidden space-y-14 lg:space-y-16">

    <!-- ================= BLOCK 1: A SANCTUARY IN HARMONY WITH NATURE (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-24" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-5">
                    A Sanctuary in Harmony with Nature
                </h2>
                <p class="font-lato text-sm sm:text-[15px] md:text-base text-[#5E6B7A] leading-relaxed">
                    Surrounded by breathtaking natural beauty and panoramic views, the hermitage offers an atmosphere of peace and silence that nurtures mindfulness and inner reflection. Designed with simplicity and harmony in mind, the hermitage features a chapel, meditation halls, and open outdoor spaces dedicated to contemplation and spiritual practices. Its minimalist architecture blends seamlessly with nature, creating a tranquil environment that encourages spiritual connection and personal renewal. The institution also embraces eco-friendly practices, including rainwater harvesting and organic vegetable cultivation, reflecting a lifestyle rooted in sustainability and simplicity.
                </p>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
        <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[380px] lg:h-[380px] xl:h-[400px] rounded-l-full overflow-hidden">
                <img src="/images/hermits-chapel-exterior.png"
                     alt="The Hermits chapel with a red cross, framed by hibiscus flowers"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: A COMMUNITY UNITED THROUGH PRAYER (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
        <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[380px] lg:h-[380px] xl:h-[400px] rounded-r-full overflow-hidden">
                <img src="/images/hermits-chapel-interior.png"
                     alt="Inside The Hermits chapel, with wooden pews and the altar"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-24" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-5">
                    A Community United<br class="hidden lg:block" />
                    Through Prayer and<br class="hidden lg:block" />
                    Fellowship
                </h2>
                <div class="font-lato space-y-5 text-sm sm:text-[15px] md:text-base text-[#5E6B7A] leading-relaxed">
                    <p>
                        <strong class="font-bold">Holy Qurbana is celebrated every Saturday</strong>, while a <strong class="font-bold">monthly meditation gathering is conducted on the last Saturday of each month</strong>. These gatherings bring together priests, nuns, spiritual organizations, and members of the public for prayer, meditation, reflection, and gardening activities. In addition, staff members from the Society’s various institutions gather at the hermitage every quarter for moments of spiritual enrichment and fellowship.
                    </p>
                    <p>
                        The Hermits has also welcomed visitors from sister institutions including Bethsada Public School, Bethsada Junior School, Guardian Angel Peace Mission Centre, and Guardian Angel Retirement Home. Through these interactions, the hermitage has grown into a sanctuary of peace, offering individuals and communities an opportunity to reconnect.
                    </p>
                </div>
            </div>
        </div>

    </div>

</section>
