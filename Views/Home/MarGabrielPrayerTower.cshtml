@{
    ViewData["Title"] = "Mar Gabriel Prayer Tower";
}

<!-- ================= MAR GABRIEL PRAYER TOWER HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[88vh] overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"
         style="background-image: url('/images/mar-gabriel-prayer-tower-hero.png');"
         role="img" aria-label="Mar Gabriel Prayer Tower and chapel, Vengola"
         data-aos="fade-in"
         data-aos-duration="1200"></div>

    <!-- White wash for readability: stronger on mobile (text spans full width), soft on the left for desktop -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/70 to-white/30 md:from-white/50 md:via-white/15 md:to-transparent pointer-events-none"></div>

    <!-- Main Content (sits in the upper-left, below the overlay header) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-14 pb-20 sm:pt-16 sm:pb-24 md:pt-36 lg:pt-44 md:pb-24">
        <div class="w-full md:w-[55%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[44px] font-semibold uppercase tracking-wide text-navy leading-[1.25]">
                Mar Gabriel Prayer Tower,<br />
                Vengola
            </h1>

            <p class="font-lato mt-4 md:mt-5 text-sm sm:text-[15px] md:text-base text-[#4A5568] leading-relaxed max-w-xl">
                The Mar Gabriel Prayer Tower and Brotherhood stands as a beacon for those seeking a life rooted in community and spiritual devotion.
            </p>

        </div>
    </div>

</section>

<!-- ================= A COMMUNITY OF PRAYER AND PURPOSE (VALUE ICONS) ================= -->
<section class="bg-[#FAF0DE] pt-14 sm:pt-16 lg:pt-20 pb-0 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

            <!-- Left Column: Heading & Description -->
            <div class="lg:col-span-5" data-aos="fade-right" data-aos-duration="900">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[48px] font-medium text-navy leading-[1.2] mb-5">
                    A community of<br class="hidden sm:block" />
                    prayer and purpose
                </h2>

                <p class="font-lato text-sm sm:text-[15px] md:text-[17px] text-[#5E6B7A] leading-relaxed">
                    This unique sanctuary offers an environment dedicated to collective prayer, collaborative work, mutual support, and a deep sense of shared responsibility. Here, individuals can find solace and strength in a structured communal setting, fostering a harmonious existence centered on spiritual growth.
                </p>
            </div>

            <!-- Right Column: 4 Value Icons -->
            <div class="lg:col-span-7" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
                <ul class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-8 items-start">

                    <li class="flex flex-col items-center text-center group">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-4">
                            <img src="/images/icon-mg-respect-tolerance.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                        </div>
                        <span class="font-lato text-sm sm:text-[15px] lg:text-base text-navy leading-snug">Respect &amp;<br />tolerance</span>
                    </li>

                    <li class="flex flex-col items-center text-center group">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-4">
                            <img src="/images/icon-mg-discipline-integrity.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                        </div>
                        <span class="font-lato text-sm sm:text-[15px] lg:text-base text-navy leading-snug">Discipline &amp;<br />integrity</span>
                    </li>

                    <li class="flex flex-col items-center text-center group">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-4">
                            <img src="/images/icon-mg-intercultural-awareness.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                        </div>
                        <span class="font-lato text-sm sm:text-[15px] lg:text-base text-navy leading-snug">Intercultural &amp; social<br />awareness</span>
                    </li>

                    <li class="flex flex-col items-center text-center group">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-28 lg:h-28 flex items-center justify-center mb-4">
                            <img src="/images/icon-mg-love-of-learning.png" alt="" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
                        </div>
                        <span class="font-lato text-sm sm:text-[15px] lg:text-base text-navy leading-snug">Love of learning &amp;<br />lifelong growth</span>
                    </li>

                </ul>
            </div>

        </div>
    </div>
</section>

<!-- ================= MEDITATION, RETREATS & GUIDANCE (CURVED IMAGE BLOCKS) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 lg:py-24 overflow-hidden space-y-14 lg:space-y-16">

    <!-- ================= BLOCK 1: THE POWER OF MEDITATION (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
        <div class="w-full lg:w-[48%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-60 sm:h-80 md:h-[340px] lg:h-[330px] rounded-r-full overflow-hidden">
                <img src="/images/mar-gabriel-meditation.png"
                     alt="A brother meditating at sunrise in the prayer tower garden"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[52%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                    The power of meditation
                </h2>
                <p class="font-lato text-sm sm:text-[15px] text-[#5E6B7A] leading-relaxed">
                    Meditation, a cornerstone of the Brotherhood's philosophy, provides a crucial respite from the relentless demands and inherent complexities of daily worldly activities. While no earthly being can ever fully escape these temporal pressures, structured periods of contemplative practice offer a vital refuge, allowing for introspection and inner peace.
                </p>
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: RETREATS FOR DEEPER RENEWAL (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[52%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                    Retreats for deeper renewal
                </h2>
                <p class="font-lato text-sm sm:text-[15px] text-[#5E6B7A] leading-relaxed">
                    Beyond daily meditation, the Brotherhood emphasizes the indispensable role of structured retreats. These dedicated periods of focused spiritual engagement are not merely beneficial but essential for profound spiritual renewal and sustained spiritual nourishment.
                </p>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
        <div class="w-full lg:w-[48%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-60 sm:h-80 md:h-[340px] lg:h-[330px] rounded-l-full overflow-hidden">
                <img src="/images/mar-gabriel-retreats.png"
                     alt="Brothers in white walking together along a garden path at dawn"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 3: GUIDANCE, PROTECTION AND HOPE (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
        <div class="w-full lg:w-[48%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-60 sm:h-80 md:h-[340px] lg:h-[330px] rounded-r-full overflow-hidden">
                <img src="/images/mar-gabriel-guidance-hope.png"
                     alt="The Mar Gabriel prayer chapel at sunset"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[52%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                    Guidance, protection and hope
                </h2>
                <p class="font-lato text-sm sm:text-[15px] text-[#5E6B7A] leading-relaxed">
                    Such consistent spiritual sustenance is considered imperative for all individuals, serving as a powerful safeguard against malevolent influences and the erosive effects of a chaotic world. The Mar Gabriel Prayer Tower and Brotherhood provides an ideal and sacred venue for individuals to embark on a journey of seeking profound divine guidance. Through this guidance, the spirit can be uplifted, and a renewed sense of hope can be cultivated, primarily through the transformative power of prayer. It is a place where faith is not just observed but actively lived, where community strengthens individual resolve, and where spiritual aspirations are nurtured and realized.
                </p>
            </div>
        </div>

    </div>

</section>
