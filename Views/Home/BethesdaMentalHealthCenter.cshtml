@{
    ViewData["Title"] = "Bethesda Mental Health Center";
}

<!-- ================= BETHESDA MENTAL HEALTH CENTER HERO SECTION ================= -->
<section class="relative bg-white min-h-[75vh] lg:min-h-[85vh] flex items-center overflow-hidden">

    <!-- Desktop / Tablet Background Image -->
    <div class="hidden md:block absolute inset-0 bg-cover bg-center lg:bg-right-bottom bg-no-repeat"
         style="background-image: url('/images/Sunlit Green Courtyard Architecture.png');"
         data-aos="fade-left"
         data-aos-duration="1200"></div>

    <!-- Soft White & Sunlight Gradient Overlay for Seamless Text Readability -->
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white via-white/20 via-42% to-transparent pointer-events-none"></div>

    <!-- Mobile Top Image -->
    <div class="md:hidden w-full" data-aos="fade-down" data-aos-duration="800">
        <img src="/images/Sunlit Green Courtyard Architecture.png"
             alt="Bethesda Mental Health Center, Vengola"
             class="w-full h-auto object-cover max-h-[380px]" />
    </div>

    <!-- Main Content Container -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-12 md:py-24 lg:py-32 w-full z-10">
        <div class="w-full md:w-[56%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <!-- Main Heading in Cormorant Garamond Font -->
            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wider text-navy leading-[1.2] mb-5">
                Bethesda Mental<br />
                Health Center, Vengola
            </h1>

            <!-- Description Paragraph in Lato Font -->
            <p class="font-lato text-xs sm:text-sm md:text-[14.5px] text-[#1E1E1E]/90 leading-relaxed max-w-xl text-justify sm:text-left">
                Established in 1992, Bethsada Mental Hospital has been serving as a center of compassionate and professional mental healthcare for individuals and families across the community. Founded in response to the growing need for accessible and humane psychiatric care, the institution was created with a vision to restore dignity, hope, and well-being to people experiencing mental health challenges.
            </p>

        </div>
    </div>

</section>
<!-- ================= CLINICAL, REHAB & AWARENESS SECTION (#FAF0DE) ================= -->
<section class="bg-[#FAF0DE] py-16 sm:py-20 lg:py-28 overflow-hidden space-y-20 lg:space-y-28">

    <!-- ================= BLOCK 1: CLINICAL SERVICES (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Clinical Services
                </h2>
                <div class="font-lato space-y-4 text-xs sm:text-[13px] md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        Bethsada Mental Hospital provides comprehensive psychiatric and psychological care through outpatient and inpatient services[cite: 35]. The hospital offers expert diagnosis, psychiatric consultations, psychological assessments, counselling, crisis intervention, and continuous inpatient care for individuals with various mental health conditions.
                    </p>
                    <p>
                        The <strong class="text-navy font-semibold">multidisciplinary team</strong> includes psychiatrists, clinical psychologists, psychiatric social workers, nurses, rehabilitation therapists, administrative staff, and support personnel who work together to ensure patient-centered care and recovery.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-l-[130px] sm:rounded-l-[190px] lg:rounded-l-[250px] rounded-r-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Compassionate Caregiver Connection.png"
                     alt="Clinical Services - Compassionate Caregiver Connection"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: REHABILITATION AND RECOVERY PROGRAMS (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Image: Bleeds to Left Screen Edge with Right Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[520px] rounded-r-[130px] sm:rounded-r-[190px] lg:rounded-r-[250px] rounded-l-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Compassionate Care and Rehabilitation Montage.png"
                     alt="Rehabilitation and Recovery Programs Montage"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28 shrink-0" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Rehabilitation and Recovery Programs
                </h2>

                <div class="font-lato space-y-3.5 text-xs sm:text-[13px] md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        Rehabilitation is a core component of the hospital's treatment philosophy[cite: 35]. The institution focuses on helping patients regain independence, confidence, and social functioning through individualized rehabilitation programs.
                    </p>

                    <p class="font-semibold text-navy pt-1">
                        Key rehabilitation services include:[cite: 35]
                    </p>
                    <ul class="space-y-1.5 pl-4 text-xs sm:text-[13px] md:text-[13.5px] list-disc list-outside text-[#1E1E1E]/85">
                        <li>Symptom management and therapeutic support for severe mental disorders[cite: 35]</li>
                        <li>Personal care training and motivation for self-reliance[cite: 35]</li>
                        <li>Family counselling and psycho-education[cite: 35]</li>
                        <li>Social skills development and activity-based interventions[cite: 35]</li>
                        <li>Vocational guidance and rehabilitation support[cite: 35]</li>
                    </ul>

                    <p class="pt-1">
                        The hospital also provides specialized geriatric and dementia care services, incorporating psychosocial interventions such as reality orientation therapy, reminiscence therapy, validation therapy, group activities, and stimulation-based programs to improve quality of life[cite: 35].
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 3: MENTAL HEALTH AWARENESS & OUTREACH (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Mental Health Awareness<br />and Community Outreach
                </h2>

                <div class="font-lato space-y-4 text-xs sm:text-[13px] md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        Promoting awareness and reducing stigma remain central to the mission of Bethsada Mental Hospital[cite: 35]. The institution regularly organizes mental health awareness programs, seminars, workshops, cultural events, poster presentations, quizzes, and community outreach initiatives in observance of important mental health awareness days, including:
                    </p>

                    <ul class="space-y-1.5 pl-4 text-xs sm:text-[13px] md:text-[13.5px] list-disc list-outside text-[#1E1E1E]/85">
                        <li>World Autism Awareness Day[cite: 35]</li>
                        <li>World Schizophrenia Awareness Day[cite: 35]</li>
                        <li>World Alzheimer's Day[cite: 35]</li>
                        <li>World Mental Health Day[cite: 35]</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-l-[130px] sm:rounded-l-[190px] lg:rounded-l-[250px] rounded-r-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Mental Health Awareness Community Talk.png"
                     alt="Mental Health Awareness and Community Outreach Talk"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

</section>


<section class="relative w-full overflow-hidden bg-white">

    <div class="absolute inset-0">
        <img src="/images/Healing-Touch-at-Sunrise.png"
             alt="Compassionate care for an elderly woman"
             class="w-full h-full object-cover object-[center_75%]" />
    </div>

    <!-- Centered Text -->
    <div class="relative z-10 min-h-[400px] sm:min-h-[450px] lg:min-h-[500px]
              flex items-center justify-center
              px-5 sm:px-10 lg:px-16">

        <div class="w-full max-w-[850px] text-center text-black">

            <p class="font-cormorant font-medium
                text-[21px] sm:text-[27px] lg:text-[38px]
                leading-[1.2]">
                “At sunset, the people brought to Jesus all who had
                various kinds of sickness, and laying his hands on
                each one, he healed them”.
            </p>

            <p class="font-cormorant font-medium
                text-[21px] sm:text-[27px] lg:text-[38px]
                leading-tight mt-1">
                {Luke 4:40}
            </p>

        </div>
    </div>

</section>

<section class="w-full bg-[#FAF0DE] py-12 lg:py-16 overflow-hidden">

    <div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 items-center gap-8 lg:gap-12">

        <!-- Left Image -->
        <div class="lg:col-span-5 w-full">
            <div class="relative w-full h-[300px] sm:h-[400px] lg:h-[390px]
                  overflow-hidden rounded-r-[180px]">

                <img src="/images/Compassionate Care and Rehabilitation Montage.png"
                     alt="Compassionate care and rehabilitation services"
                     class="w-full h-full object-cover object-center" />

            </div>
        </div>

        <!-- Right Content -->
        <div class="lg:col-span-7 px-6 sm:px-10 lg:px-8 lg:pr-16">

            <h2 class="font-cormorant text-[#192F60]
                 text-3xl sm:text-4xl lg:text-[40px]
                 font-semibold leading-tight mb-4">

                Our Commitment

            </h2>

            <div class="font-nunito text-[#607D98]
                  text-sm sm:text-base lg:text-[17px]
                  leading-[1.4] space-y-5">

                <p>
                    Looking after the sick certainly is one of the very important
                    facets of Christian Mission. And we have lots of Missionary
                    Hospitals spread across the country, who are all doing quite
                    a good service. Among physical health, one thing that often
                    gets neglected is mental health which varies very widely in
                    nature and character from case to case. Often, due to a sort
                    stigma, people tend to hide mental disorders or such ill
                    functioning of relatives which makes greater problems at
                    later stages. These sorts of things do happen due to lack of
                    proper awareness among the people and the Society decided
                    to initiate efforts to rectify them as best as possible.
                    Bethsada Mental Health Center is the result of these efforts.
                </p>

                <p>
                    Custodial Care facility (for mental patients unmanageable
                    at home due to old age or chronic nature) This Center provides
                    training facilities for Nursing Schools and Colleges for their
                    students and most of the leading Colleges in and around
                    Ernakulam are making use of them with total satisfaction.
                    Even, institutions outside Kerala too approach us for such
                    facilities. Psycho educational programs are organized
                    periodically. Round the clock Ambulance service too is available.
                </p>

            </div>
        </div>

    </div>
</section>

