@{
    ViewData["Title"] = "Bethesda Mental Health Center";
}

<!-- ================= BETHESDA MENTAL HEALTH CENTER HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[85vh] flex items-center overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div class="absolute inset-0 bg-cover bg-center lg:bg-right-bottom bg-no-repeat"
         style="background-image: url('/images/Sunlit Green Courtyard Architecture.png');"
         role="img" aria-label="Bethesda Mental Health Center, Vengola"
         data-aos="fade-left"
         data-aos-duration="1200"></div>

    <!-- White Gradient Overlay: strong on mobile (text spans full width); on desktop white only behind the text, then fades out -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 md:from-white/95 md:from-20% md:via-white/75 md:via-45% md:to-transparent md:to-60% pointer-events-none"></div>

    <!-- Main Content Container -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-16 md:py-24 lg:py-32 w-full z-10">
        <div class="w-full md:w-[56%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <!-- Main Heading in Cormorant Garamond Font -->
            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wider text-navy leading-[1.2] mb-5">
                Bethesda Mental<br />
                Health Center, Vengola
            </h1>

            <!-- Description Paragraph in Lato Font -->
            <p class="font-lato text-sm md:text-[14.5px] text-[#1E1E1E]/90 leading-relaxed max-w-xl text-left">
                Established in 1992, Bethsada Mental Hospital has been serving as a center of compassionate and professional mental healthcare for individuals and families across the community. Founded in response to the growing need for accessible and humane psychiatric care, the institution was created with a vision to restore dignity, hope, and well-being to people experiencing mental health challenges.
            </p>

        </div>
    </div>

</section>
<!-- ================= CLINICAL, REHAB & AWARENESS SECTION (#FAF0DE) ================= -->
<section class="bg-[#FAF0DE] py-16 sm:py-20 lg:py-28 overflow-hidden space-y-20 lg:space-y-28">

    <!-- ================= BLOCK 1: CLINICAL SERVICES (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Clinical Services
                </h2>
                <div class="font-lato space-y-4 text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        Bethsada Mental Hospital provides comprehensive psychiatric and psychological care through outpatient and inpatient services. The hospital offers expert diagnosis, psychiatric consultations, psychological assessments, counselling, crisis intervention, and continuous inpatient care for individuals with various mental health conditions.
                    </p>
                    <p>
                        The <strong class="text-navy font-semibold">multidisciplinary team</strong> includes psychiatrists, clinical psychologists, psychiatric social workers, nurses, rehabilitation therapists, administrative staff, and support personnel who work together to ensure patient-centered care and recovery.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-l-[130px] sm:rounded-l-[190px] lg:rounded-l-[250px] rounded-r-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Compassionate Caregiver Connection.png"
                     alt="Clinical Services - Compassionate Caregiver Connection"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: REHABILITATION AND RECOVERY PROGRAMS (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Image: Bleeds to Left Screen Edge with Right Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[520px] rounded-r-[130px] sm:rounded-r-[190px] lg:rounded-r-[250px] rounded-l-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Compassionate Care and Rehabilitation Montage.png"
                     alt="Rehabilitation and Recovery Programs Montage"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-28 shrink-0" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Rehabilitation and Recovery Programs
                </h2>

                <div class="font-lato space-y-3.5 text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        Rehabilitation is a core component of the hospital's treatment philosophy. The institution focuses on helping patients regain independence, confidence, and social functioning through individualized rehabilitation programs.
                    </p>

                    <p class="font-semibold text-navy pt-1">
                        Key rehabilitation services include:
                    </p>
                    <ul class="space-y-1.5 pl-4 text-sm md:text-[13.5px] list-disc list-outside text-[#1E1E1E]/85">
                        <li>Symptom management and therapeutic support for severe mental disorders</li>
                        <li>Personal care training and motivation for self-reliance</li>
                        <li>Family counselling and psycho-education</li>
                        <li>Social skills development and activity-based interventions</li>
                        <li>Vocational guidance and rehabilitation support</li>
                    </ul>

                    <p class="pt-1">
                        The hospital also provides specialized geriatric and dementia care services, incorporating psychosocial interventions such as reality orientation therapy, reminiscence therapy, validation therapy, group activities, and stimulation-based programs to improve quality of life.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 3: MENTAL HEALTH AWARENESS & OUTREACH (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-tight mb-5">
                    Mental Health Awareness<br />and Community Outreach
                </h2>

                <div class="font-lato space-y-4 text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed text-justify sm:text-left">
                    <p>
                        Promoting awareness and reducing stigma remain central to the mission of Bethsada Mental Hospital. The institution regularly organizes mental health awareness programs, seminars, workshops, cultural events, poster presentations, quizzes, and community outreach initiatives in observance of important mental health awareness days, including:
                    </p>

                    <ul class="space-y-1.5 pl-4 text-sm md:text-[13.5px] list-disc list-outside text-[#1E1E1E]/85">
                        <li>World Autism Awareness Day</li>
                        <li>World Schizophrenia Awareness Day</li>
                        <li>World Alzheimer's Day</li>
                        <li>World Mental Health Day</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-72 sm:h-96 md:h-[460px] lg:h-[500px] rounded-l-[130px] sm:rounded-l-[190px] lg:rounded-l-[250px] rounded-r-none overflow-hidden shadow-xl bg-[#FAF0DE]">
                <img src="/images/Mental Health Awareness Community Talk.png"
                     alt="Mental Health Awareness and Community Outreach Talk"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>

</section>

<!-- ================= EDUCATION, DIGITAL AWARENESS & COMMITMENT (3 CARDS) ================= -->
<section class="bg-white py-14 sm:py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 lg:gap-12">

            <!-- Card 1: Education, Training & Academic Support -->
            <div data-aos="fade-up" data-aos-duration="900">
                <div class="w-full h-52 sm:h-60 md:h-44 lg:h-52 rounded-2xl overflow-hidden shadow-md mb-5">
                    <img src="/images/bethesda-education-training.png"
                         alt="A psychiatrist teaching nursing and psychology students about mental health"
                         class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
                </div>
                <h3 class="font-lato text-lg lg:text-xl font-medium text-navy leading-snug mb-3">
                    Education, Training, &amp; Academic Support
                </h3>
                <p class="font-lato text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed">
                    The hospital also functions as a teaching and training center for students and professionals in the fields of psychology, psychiatric social work, and nursing. The institution provides internships, clinical postings, orientation programs, and practical training opportunities for students from various academic institutions. These academic collaborations help nurture future mental health professionals while promoting greater awareness and understanding of mental healthcare in society.
                </p>
            </div>

            <!-- Card 2: Digital Mental Health Awareness -->
            <div data-aos="fade-up" data-aos-duration="900" data-aos-delay="150">
                <div class="w-full h-52 sm:h-60 md:h-44 lg:h-52 rounded-2xl overflow-hidden shadow-md mb-5">
                    <img src="/images/bethesda-digital-awareness.png"
                         alt="A nurse working on the Mind Health Club website and social media"
                         class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
                </div>
                <h3 class="font-lato text-lg lg:text-xl font-medium text-navy leading-snug mb-3">
                    Digital Mental Health Awareness
                </h3>
                <p class="font-lato text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed">
                    Through its Mind Health Club and digital outreach platforms, the hospital actively promotes mental health education and awareness among the public. Educational content addressing social, psychological, legal, and emotional issues is shared through online platforms and community engagement programs to encourage informed conversations about mental health and well-being.
                </p>
            </div>

            <!-- Card 3: Commitment to Society -->
            <div data-aos="fade-up" data-aos-duration="900" data-aos-delay="300">
                <div class="w-full h-52 sm:h-60 md:h-44 lg:h-52 rounded-2xl overflow-hidden shadow-md mb-5">
                    <img src="/images/bethesda-commitment-society.png"
                         alt="A nurse walking with a patient through the hospital courtyard"
                         class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
                </div>
                <h3 class="font-lato text-lg lg:text-xl font-medium text-navy leading-snug mb-3">
                    Commitment to Society
                </h3>
                <p class="font-lato text-sm md:text-[14px] text-[#1E1E1E]/85 leading-relaxed">
                    Over the decades, Bethsada Mental Hospital has positively impacted countless individuals and families by improving access to mental healthcare, promoting rehabilitation, and supporting social reintegration. The institution continues to evolve by adopting modern treatment approaches, expanding services, and strengthening outreach initiatives to better serve the community. With a continued commitment to compassionate care, awareness, rehabilitation, and inclusivity, Bethsada Mental Hospital remains dedicated to building a healthier and more understanding society.
                </p>
            </div>

        </div>
    </div>
</section>
<!-- ================= OUR SERVICES (12 ICONS ON LEAF BACKGROUND) ================= -->
