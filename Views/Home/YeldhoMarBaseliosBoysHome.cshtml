@{
    ViewData["Title"] = "Yeldho Mar Baselios Boy’s Home";
}

<!-- ================= YELDHO MAR BASELIOS BOY'S HOME HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[85vh] flex items-center overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div class="absolute inset-0 bg-cover bg-center lg:bg-right-bottom bg-no-repeat"
         style="background-image: url('/images/Sunlit Pink Campus in Bloom.png');"
         role="img" aria-label="Yeldho Mar Baselios Boy's Home, Kothamangalam"
         data-aos="fade-left"
         data-aos-duration="1200"></div>

    <!-- White Gradient Overlay for Text Readability (stronger on mobile where text spans full width) -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 md:from-white md:via-white/20 md:via-42% md:to-transparent pointer-events-none"></div>

    <!-- Main Content Container -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-16 md:py-24 lg:py-32 w-full z-10">
        <div class="w-full md:w-[56%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <!-- Main Heading in Cormorant Garamond Font -->
            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wider text-navy leading-[1.2] mb-5">
                Yeldho Mar Baselios<br />
                Boy's Home, Kothamangalam
            </h1>

            <!-- Description Paragraph in Lato Font -->
            <p class="font-lato text-sm md:text-[15px] text-[#1E1E1E]/90 leading-relaxed max-w-xl text-justify sm:text-left">
                This activity goes on strongly for the last 25 years and so far more than 600 children have been nurtured well enough that most of them are now independently taking care of themselves and even their kith and kin.
            </p>

        </div>
    </div>

</section>
<!-- ================= OUR STORY SECTION (CHURCH HERITAGE) ================= -->
<section class="relative bg-[#fbf9f4] bg-cover bg-left lg:bg-center bg-no-repeat py-12 sm:py-20 lg:py-28 overflow-hidden lg:min-h-[580px] flex items-center"
         style="background-image: url('/images/Pastel Church Brochure with Sunrise Space.png');">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 w-full z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

            <!-- Left Spacer Column (Allows the church structure & sunrise to show clearly) -->
            <div class="hidden lg:block lg:col-span-6 xl:col-span-7 h-full"></div>

            <!-- Right Content Column -->
            <div class="lg:col-span-6 xl:col-span-5 bg-white/75 lg:bg-transparent backdrop-blur-sm lg:backdrop-blur-none p-6 sm:p-8 lg:p-0 rounded-2xl lg:rounded-none shadow-sm lg:shadow-none"
                 data-aos="fade-left"
                 data-aos-duration="900">
                <!-- Heading -->
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold uppercase tracking-wider text-navy leading-tight mb-5">
                    Our Story
                </h2>

                <!-- Description Paragraphs -->
                <div class="font-lato space-y-3.5 text-[#1E1E1E]/90 text-sm md:text-[14px] leading-relaxed text-justify sm:text-left">
                    <p>
                        Yeldho Mar Baselios Boys Home, Kothamangalam, was established with the noble vision of providing care, protection, shelter, and education to underprivileged, orphaned, and socially disadvantaged boys. The institution was founded in response to the growing need for a safe and supportive environment where vulnerable children could receive proper care, guidance, and opportunities for a better future.
                    </p>

                    <p>
                        From its very beginning, the Home has been sustained through the generous support, prayers, and contributions of kind-hearted people from both near and far, including church members, well-wishers, philanthropists, and members of the wider community whose compassion and commitment continue to strengthen its mission.
                    </p>
                </div>

            </div>

        </div>
    </div>
</section>
<section class="relative w-full overflow-hidden bg-[#fff9ed]">

    <!-- Background Image -->
    <div class="absolute inset-0">
        <img src="/images/Sunlit Garden Reading Nook.png"
             alt=""
             class="w-full h-full object-cover lg:object-fill" />
    </div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-[1600px] mx-auto">

        <!-- Bible Verse -->
        <div class="min-h-[220px] sm:min-h-[290px] lg:min-h-[300px]
                flex items-start justify-center text-center
                px-5 pt-14 sm:pt-16 lg:pt-[65px]">

            <p class="font-cormorant text-[#000000]
                text-[21px] sm:text-[25px] lg:text-[27px]
                leading-[1.25] font-medium">

                Start children off on the way they should go, and
                <br class="hidden sm:block">

                even when they are old they will not turn from it”.
                <br>

                <span class="font-medium">{Proverbs 22:6}</span>

            </p>
        </div>

        <!-- Main Content -->
        <!-- Mobile/tablet: white card so the text is readable over the image -->
        <div class="mx-4 sm:mx-6 lg:mx-0 mb-10 lg:mb-0 p-5 sm:p-8 lg:p-0 lg:px-[6.3%]
                lg:pt-2 lg:pb-12 bg-white/85 lg:bg-transparent backdrop-blur-sm lg:backdrop-blur-none
                rounded-2xl lg:rounded-none shadow-sm lg:shadow-none">

            <!-- Section Heading -->
            <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold
                 mb-3 sm:mb-4">

                A journey of 25 years

            </h2>

            <!-- Description -->
            <div class="font-nunito text-[#5E788C]
                  text-sm lg:text-[12px]
                  leading-[1.4] space-y-4 text-left">

                <p>
                    This activity goes on strongly for the last 25 years and so far
                    more than 600 children have been nurtured well enough that most
                    of them are now independently taking care of themselves and
                    even their kith and kin. Boys who are orphans in as much as that
                    both parents are not there or at least have lost one of the
                    parents are considered eligible for admission if aged 10 or
                    above, but less than 12, irrespective of caste, creed or
                    religion. All their basic needs are taken care of very decently
                    and are sent to nearby schools and educated up to class 10.
                    After this, they are provided guidelines for proceeding further
                    because wise and all necessary assistance are provided.
                </p>

                <p>
                    The library at the orphanage has good materials for the boys
                    to equip themselves to face the world ahead of them as well as
                    for their spiritual nourishment. Proper training is offered
                    for character formation and development of their histrionic
                    talents. All these services are provided absolutely free of
                    cost, including dress, uniform at schools, medical treatment
                    and all such needs. The orphanage functions purely on donations
                    received from benefactors spread across the State of Kerala
                    and even outside. The orphanage which commenced with 5 boys
                    in a small rented house now has grown into a three storied
                    building owned by the society thanks to the good minded people
                    and great prudential blessings.
                </p>

            </div>
        </div>
    </div>
</section>
<!-- ================= CARE EDUCATION & HOLISTIC DEVELOPMENT SECTION ================= -->
<section class="bg-[#FBF6EB] py-16 sm:py-20 lg:py-28 overflow-hidden">
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="max-w-xl">

                <!-- Heading -->
                <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold text-navy leading-[1.2] mb-6">
                    Care Education &amp; Holistic<br />
                    Development
                </h2>

                <!-- Description Paragraphs -->
                <div class="font-lato space-y-4 text-sm md:text-[13.5px] text-[#1E1E1E]/80 leading-relaxed text-justify sm:text-left">
                    <p>
                        The Boys Home remains dedicated to creating a nurturing atmosphere where children are encouraged to grow into responsible, educated, and morally strong individuals. Safe accommodation and essential modern facilities are provided to ensure the comfort and well-being of the children. Along with formal school education, regular tuition classes and study support programs are conducted to strengthen their academic performance. Weekly library sessions encourage reading habits and help broaden the children's knowledge and creativity.
                    </p>

                    <p>
                        Recognizing the importance of digital learning in today's world, the Home provides access to computers and mobile devices to support education and improve digital literacy. Personality development programs, counseling sessions, and value-based guidance are also organized regularly to help children build confidence, discipline, and emotional well-being.
                    </p>

                    <p>
                        Spiritual and moral development remains an integral part of the institution's activities. The children actively participate in classes and programs organized by Kothamangalam Valiyapally and are encouraged to take part in competitions, cultural events, and community activities. The Home celebrates important national days, religious festivals, and special occasions with great enthusiasm, helping to create a joyful family atmosphere among the children. Events such as Pravesanolsavam, Independence Day celebrations, Onam, Christmas, and birthday celebrations are observed with warmth and togetherness.
                    </p>

                    <p>
                        In addition to academic and cultural activities, the institution promotes extracurricular participation and social interaction to ensure the overall development of the children. Through these combined efforts, Yeldho Mar Baselios Boys Home continues to provide children with shelter, education, care, guidance, and opportunities for a brighter and more secure future.
                    </p>
                </div>

            </div>
        </div>

        <!-- Right Image: Bleeds to Right Edge with Left Arch Curve -->
        <div class="w-full lg:w-[52%] xl:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-80 sm:h-96 md:h-[480px] lg:h-[560px] rounded-l-[140px] sm:rounded-l-[200px] lg:rounded-l-[260px] rounded-r-none overflow-hidden shadow-xl bg-[#FBF6EB]">
                <img src="/images/Sunlit Mural Classroom Library.png"
                     alt="Care Education & Holistic Development - Classroom Library"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>
</section>