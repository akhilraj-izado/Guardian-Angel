@model GuardianAngel.Models.ContactForm
@{
    ViewData["Title"] = "Contact";
    const string fieldClass = "font-lato w-full px-4 py-3.5 rounded-xl border border-sky/70 bg-transparent text-sm text-navy placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-sky/40 focus:border-sky transition-all";
    const string errorClass = "font-lato block mt-1 text-xs text-red-600";
    ViewData["BodyClass"] = "font-cormorant text-navy bg-[#FAF4E6] antialiased";
}

<!-- ================= CONTACT US SECTION (HERO BACKGROUND WITH TOP PADDING) ================= -->
<section class="bg-[#FAF4E6] pt-28 sm:pt-36 md:pt-40 pb-16 md:pb-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Header & Subtitle -->
    <div class="text-center mb-12 md:mb-16" data-aos="fade-down" data-aos-duration="800">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-wide">
        <span class="text-sky">CONTACT</span> <span class="text-navy">US</span>
      </h2>
      <p class="font-lato mt-3 text-sm sm:text-base md:text-[17px] text-[#1E1E1E] max-w-2xl mx-auto">
        Do you have any queries? Feel free to drop us your message. We will get in touch with you.
      </p>
    </div>

    <!-- Contact Grid: Left Details | Right Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Contact Detail -->
      <div class="lg:col-span-5 space-y-8" data-aos="fade-right" data-aos-duration="900">
        <div>
          <h3 class="font-cormorant text-2xl sm:text-3xl font-bold text-navy">
            Contact Detail
          </h3>
          <p class="font-lato text-xs sm:text-sm text-[#1E1E1E]/80 mt-1">
            Let's Get in Touch...
          </p>
        </div>

        <div class="space-y-6 pt-2">
          <!-- Phone Item -->
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 shrink-0 mt-0.5">
              <img src="/images/icon-contact-phone.png" alt="Phone" class="w-full h-full object-contain" />
            </div>
            <div>
              <p class="font-lato text-base sm:text-lg font-bold text-navy leading-tight">
                +91 XXXXX XXXXX
              </p>
              <p class="font-lato text-xs text-gray-500 mt-1">
                Mon - Fri 9 am to 6 pm
              </p>
            </div>
          </div>

          <!-- Email Item -->
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 shrink-0 mt-0.5">
              <img src="/images/icon-contact-email.png" alt="Email" class="w-full h-full object-contain" />
            </div>
            <div>
              <a href="mailto:info@guardianangelcare.org" class="font-lato text-sm sm:text-base font-bold text-navy leading-tight hover:text-sky transition-colors">
                info@guardianangelcare.org
              </a>
              <p class="font-lato text-xs text-gray-500 mt-1">
                Email Id
              </p>
            </div>
          </div>

          <!-- Address Item -->
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 shrink-0 mt-0.5">
              <img src="/images/icon-contact-location.png" alt="Location" class="w-full h-full object-contain" />
            </div>
            <div>
              <p class="font-lato text-sm sm:text-base font-bold text-navy leading-tight">
                Airapuram P.O., Keezhillam,
              </p>
              <p class="font-lato text-xs text-gray-500 mt-1">
                Ernakulam, Kerala
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="lg:col-span-7" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
        <form id="contact-form" asp-controller="Home" asp-action="Contact" method="post" class="space-y-4 scroll-mt-28">

          @if (TempData["ContactSuccess"] is string success)
          {
            <div class="font-lato flex items-start gap-3 rounded-xl border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-800" role="status">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span>@success</span>
            </div>
          }

          <!-- Name & Email Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <input asp-for="Name" type="text" placeholder="Name" required class="@fieldClass" />
              <span asp-validation-for="Name" class="@errorClass"></span>
            </div>
            <div>
              <input asp-for="Email" type="email" placeholder="Email" required class="@fieldClass" />
              <span asp-validation-for="Email" class="@errorClass"></span>
            </div>
          </div>

          <!-- Subject Input -->
          <div>
            <input asp-for="Subject" type="text" placeholder="Subject" required class="@fieldClass" />
            <span asp-validation-for="Subject" class="@errorClass"></span>
          </div>

          <!-- Message Textarea -->
          <div>
            <textarea asp-for="Message" rows="6" placeholder="Message" required class="@fieldClass resize-none"></textarea>
            <span asp-validation-for="Message" class="@errorClass"></span>
          </div>

          <!-- Captcha -->
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <img id="captcha-img" src="/captcha" alt="Security code" width="180" height="56" class="rounded-xl border border-sky/70 bg-white" />
              <button type="button" id="captcha-refresh" class="w-11 h-11 rounded-full border border-sky/70 flex items-center justify-center text-navy hover:bg-navy hover:text-white transition-colors" aria-label="Show a new code" title="Show a new code">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.6 15A7 7 0 0 0 18.4 17M18.4 9A7 7 0 0 0 5.6 7" /></svg>
              </button>
              <input id="Captcha" name="Captcha" type="text" value="" placeholder="Enter the code" required autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="5" class="@fieldClass flex-1 min-w-[10rem] uppercase tracking-[0.3em] placeholder:normal-case placeholder:tracking-normal" />
            </div>
            <span asp-validation-for="Captcha" class="@errorClass"></span>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="font-lato inline-flex items-center gap-2 bg-navy hover:bg-[#121f42] text-white px-7 py-3 rounded-full text-xs sm:text-sm font-semibold transition-all shadow-sm hover:shadow group"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>

        </form>
      </div>

    </div>

  </div>
</section>

@section Scripts {
<script>
  // Load a fresh captcha image (the old code stops working)
  document.getElementById('captcha-refresh').addEventListener('click', () => {
    document.getElementById('captcha-img').src = '/captcha?t=' + Date.now();
    const input = document.getElementById('Captcha');
    input.value = '';
    input.focus();
  });
</script>
}
