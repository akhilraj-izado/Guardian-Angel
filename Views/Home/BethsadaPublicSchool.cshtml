@{
    ViewData["Title"] = "Bethsada Public School";
}

<!-- ================= BETHSADA PUBLIC SCHOOL HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[85vh] flex items-center overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div role="img" aria-label="Bethsada Public School Campus" class="absolute inset-0 bg-cover bg-center lg:bg-right-bottom bg-no-repeat"
         style="background-image: url('/images/Bethsada Public School Campus.png');"
         data-aos="fade-left"
         data-aos-duration="1200"></div>

    <!-- Soft White & Sunlight Gradient Overlay for Smooth Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 md:from-white/95 md:from-20% md:via-white/75 md:via-45% md:to-transparent md:to-60% pointer-events-none"></div>

    <!-- Main Content Container -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-16 md:py-24 lg:py-32 w-full z-10">
        <div class="w-full md:w-[58%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <!-- Main Heading in Cormorant Garamond Font -->
            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold uppercase tracking-wider text-navy leading-[1.2] mb-5">
                Bethsada Public School:<br />
                A Legacy of Quality<br />
                Education Since 1996
            </h1>

            <!-- Description Paragraph in Lato Font -->
            <p class="font-lato text-sm md:text-[14.5px] text-[#1E1E1E]/90 leading-relaxed max-w-xl text-left">
                The school is proudly affiliated with the Central Board of Secondary Education (CBSE), New Delhi, ensuring a curriculum that is both rigorous and nationally recognized. This affiliation provides students with a strong academic foundation, preparing them for future educational endeavors and diverse career paths.
            </p>

        </div>
    </div>

</section>

<!-- ================= CLINICAL, REHAB & AWARENESS SECTION (#FAF0DE) ================= -->
<section class="bg-[#FAF0DE] py-16 sm:py-20 lg:py-28 overflow-hidden space-y-20 lg:space-y-28">

    <!-- ================= BLOCK 1: CLINICAL SERVICES (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[48%] xl:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-28 shrink-0" data-aos="fade-right" data-aos-duration="900">
