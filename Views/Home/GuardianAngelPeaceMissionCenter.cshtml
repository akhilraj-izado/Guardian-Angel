@section Scripts {
    <script>
        // Accordion: one item open at a time; clicking an item opens it and closes the rest.
        // Clicking the item that is already open closes it.
        (function () {
            var items = document.querySelectorAll('#pmc-accordion .pmc-acc-item');

            function setOpen(item, open) {
                var panel = item.querySelector('.pmc-acc-panel');
                panel.classList.toggle('grid-rows-[1fr]', open);
                panel.classList.toggle('grid-rows-[0fr]', !open);
                item.querySelector('.pmc-acc-icon').classList.toggle('rotate-180', open);
                item.querySelector('.pmc-acc-btn').setAttribute('aria-expanded', open);
            }

            items.forEach(function (item) {
                item.querySelector('.pmc-acc-btn').addEventListener('click', function () {
                    var wasOpen = this.getAttribute('aria-expanded') === 'true';
                    items.forEach(function (other) { setOpen(other, false); });
                    if (!wasOpen) setOpen(item, true);
                });
            });
        })();
    </script>
}
