@{
    ViewData["Title"] = "Guardian Angel Peace Mission Center";
}

<!-- ================= GUARDIAN ANGEL PEACE MISSION CENTER HERO SECTION ================= -->
<section class="relative bg-white pt-[68px] sm:pt-[76px] md:pt-0 md:min-h-[75vh] lg:min-h-[88vh] overflow-hidden">

    <!-- Background Image (all screen sizes; text sits on top of it) -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat"
         style="background-image: url('/images/peace-mission-centre-hero.png');"
         role="img" aria-label="Entrance of Guardian Angel Peace Mission Centre, Nedumbassherry"
         data-aos="fade-in"
         data-aos-duration="1200"></div>

    <!-- White Gradient Overlay: strong on mobile (text spans full width); on desktop white only behind the text, then fades out -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 md:from-white/95 md:from-20% md:via-white/75 md:via-50% md:to-transparent md:to-65% pointer-events-none"></div>

    <!-- Main Content (sits in the upper-left, below the overlay header) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-14 pb-20 sm:pt-16 sm:pb-24 md:pt-36 lg:pt-44 md:pb-24">
        <div class="w-full md:w-[55%] lg:w-[50%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[44px] font-semibold uppercase tracking-wide text-navy leading-[1.25]">
                Guardian Angel Peace Mission<br class="hidden sm:block" />
                Center, Nedumbassherry.
            </h1>

            <p class="font-lato mt-4 md:mt-5 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/90 leading-relaxed max-w-xl">
                Guardian Angel Peace Mission Centre is a dedicated humanitarian institution committed to providing compassionate palliative and holistic care for critically ill cancer patients, elderly individuals, and vulnerable members of society.
            </p>

        </div>
    </div>

</section>

<!-- ================= ABOUT THE CENTER (RIGHT BLEED, LEFT CURVE) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 overflow-hidden">
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-24" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[44px] font-semibold text-navy leading-[1.25] mb-5">
                    About the center
                </h2>
                <p class="font-lato text-sm sm:text-[15px] md:text-[17px] text-[#1E1E1E]/85 leading-relaxed">
                    Located near Cochin International Airport in Nedumbassery, Kerala, the Guardian Angel Peace Mission Centre serves as a place of hope, dignity, peace, and compassionate support for individuals facing terminal illness, pain, loneliness, and prolonged suffering. Rooted in the belief that every human life deserves dignity and comfort, the Centre focuses on relieving pain, reducing suffering, and improving quality of life through professional medical care combined with emotional, psychological, social, and spiritual support. For many patients and families, the Peace Mission Centre is not merely a healthcare institution, but a sanctuary of humanity, compassion, and care during life’s most difficult journey.
                </p>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
        <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[380px] lg:h-[360px] xl:h-[380px] rounded-l-full overflow-hidden">
                <img src="/images/peace-mission-centre-building.png"
                     alt="Guardian Angel Peace Mission Centre building, Nedumbassery"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>
</section>

<!-- ================= OUR MISSION & OUR VISION (CARDS) ================= -->
<section class="bg-[#FAF0DE] pt-2 pb-14 sm:pb-16 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">

            <!-- Our Mission Card -->
            <div class="lg:col-span-9 bg-white border border-navy/80 rounded-3xl px-6 py-8 sm:px-9 sm:py-10" data-aos="fade-up" data-aos-duration="900">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-6">
                    Our Mission
                </h2>
                <ul class="font-lato list-disc marker:text-[#1E1E1E]/85 pl-5 sm:pl-10 space-y-1.5 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                    <li class="pl-2 sm:pl-4">To provide free residential palliative care for critically ill cancer patients during the residual stage of life</li>
                    <li class="pl-2 sm:pl-4">To offer compassionate medical, nursing, emotional, psychological, and spiritual support</li>
                    <li class="pl-2 sm:pl-4">To uphold dignity in life and dignity in death</li>
                    <li class="pl-2 sm:pl-4">To improve the quality of life of patients facing terminal illness and chronic suffering</li>
                    <li class="pl-2 sm:pl-4">To provide residential geriatric care for elderly individuals requiring continuous support and care</li>
                    <li class="pl-2 sm:pl-4">To extend home-based palliative and nursing care services for bedridden and seriously ill patients</li>
                    <li class="pl-2 sm:pl-4">To support caregivers and families through counseling and compassionate guidance</li>
                    <li class="pl-2 sm:pl-4">To ensure healthcare services reach poor, marginalized, and vulnerable communities</li>
                </ul>
            </div>

            <!-- Our Vision Card -->
            <div class="lg:col-span-3 bg-white border border-navy/80 rounded-3xl px-6 py-8 sm:px-8 sm:py-10" data-aos="fade-up" data-aos-duration="900" data-aos-delay="150">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-6">
                    Our Vision
                </h2>
                <p class="font-lato text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                    To build a compassionate society where critically ill patients, elderly individuals, and suffering families receive holistic, dignified, and peaceful care during the most vulnerable stages of life.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- ================= TWO SPECIALIZED WINGS OF CARE (CURVED IMAGE BLOCKS) ================= -->
<section class="bg-[#FAF0DE] pt-4 pb-14 sm:pb-16 lg:pb-24 overflow-hidden">

    <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[44px] font-semibold text-navy leading-tight text-center px-4 mb-10 lg:mb-12" data-aos="fade-up" data-aos-duration="900">
        Two Specialized Wings of Care
    </h2>

    <div class="space-y-14 lg:space-y-16">

        <!-- ================= BLOCK 1: PALLIATIVE CARE WING (LEFT BLEED, RIGHT CURVE) ================= -->
        <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

            <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
            <div class="w-full lg:w-[48%] shrink-0" data-aos="fade-right" data-aos-duration="900">
                <div class="w-full h-64 sm:h-80 md:h-[360px] lg:h-[340px] xl:h-[360px] rounded-r-full overflow-hidden">
                    <img src="/images/peace-mission-palliative-care.png"
                         alt="A nurse comforting an elderly patient in the palliative care wing"
                         class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
                </div>
            </div>

            <!-- Right Content Column -->
            <div class="w-full lg:w-[52%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-24" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
                <div class="max-w-2xl">
                    <h3 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-3">
                        Palliative Care Wing
                    </h3>
                    <h4 class="font-cormorant text-2xl sm:text-[28px] font-semibold text-navy leading-tight mb-4">
                        Caring Beyond Cure
                    </h4>
                    <div class="font-lato space-y-5 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <p>
                            The Palliative Care Wing of the Center is specially dedicated to critically ill cancer patients who require continuous support, pain management, emotional reassurance, and dignified residential care during the final stages of life.
                        </p>
                        <p>
                            The Center recognizes that when cure is no longer possible, compassionate care becomes the most meaningful form of healing. The focus therefore shifts from curing disease to relieving suffering, ensuring comfort, and helping patients live peacefully and meaningfully during their remaining days.
                        </p>
                        <p>
                            Capacity: <strong class="font-bold">45 patients</strong><br />
                            Services provided: <strong class="font-bold">completely free of charge</strong>
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <!-- ================= BLOCK 2: GERIATRIC CARE WING (RIGHT BLEED, LEFT CURVE) ================= -->
        <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

            <!-- Left Content Column -->
            <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-24" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
                <div class="max-w-xl">
                    <h3 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                        Geriatric Care Wing
                    </h3>
                    <div class="font-lato space-y-5 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <p>
                            The Geriatric Care Wing provides compassionate residential support and healthcare services for elderly individuals who require long-term care, supervision, and assistance in daily living.
                        </p>
                        <p>
                            The Center offers a safe, clean, caring, and dignified environment where senior citizens receive medical attention, nursing support, nutritious food, emotional companionship, and respectful care. The recurring expenses for geriatric care are reimbursed at highly nominal rates compared to similar facilities, ensuring affordability and accessibility for families.
                        </p>
                        <p>
                            Capacity: <strong class="font-bold">52 residents</strong><br />
                            Nominal recurring expenses
                        </p>
                    </div>
                </div>
            </div>

            <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
            <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
                <div class="w-full h-64 sm:h-80 md:h-[360px] lg:h-[340px] xl:h-[360px] rounded-l-full overflow-hidden">
                    <img src="/images/peace-mission-geriatric-care.png"
                         alt="A nurse assisting an elderly resident in a wheelchair in the geriatric care wing"
                         class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
                </div>
            </div>

        </div>

    </div>
</section>

<!-- ================= SERVICES & FACILITIES (ACCORDION) ================= -->
<section class="bg-[#FAF0DE] pb-14 sm:pb-16 lg:pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 space-y-3" id="pmc-accordion" data-aos="fade-up" data-aos-duration="900">

        <!-- Item 1 (open by default) -->
        <div class="pmc-acc-item bg-white rounded-xl shadow-[0_3px_6px_rgba(0,0,0,0.18)]" data-open="true">
            <button type="button" class="pmc-acc-btn w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-5 text-left" aria-expanded="true">
                <span class="font-cormorant text-xl sm:text-2xl lg:text-[28px] font-semibold text-navy leading-tight">Palliative Care Services</span>
                <svg class="pmc-acc-icon shrink-0 w-4 h-4 sm:w-5 sm:h-5 text-black transition-transform duration-300 rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 6h16l-8 9z" /></svg>
            </button>
            <div class="pmc-acc-panel grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out">
                <div class="overflow-hidden">
                    <div class="font-lato px-5 sm:px-6 pb-6 space-y-4 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <p>
                            The Centre provides specialized palliative care services for patients suffering from advanced cancer and other life-limiting illnesses.
                        </p>
                        <div>
                            <h4 class="font-bold text-navy mb-2">Services Include</h4>
                            <ul class="list-disc pl-5 sm:pl-6 md:columns-2 md:gap-10 space-y-1">
                                <li class="pl-2">Residential inpatient palliative care</li>
                                <li class="pl-2">Outpatient (OP) consultation services</li>
                                <li class="pl-2">Pain and symptom management</li>
                                <li class="pl-2">Doctor and nursing care</li>
                                <li class="pl-2">Laboratory facilities for medical investigations</li>
                                <li class="pl-2">Distribution of medicines and medical supplies</li>
                                <li class="pl-2">Emotional and psychological counseling</li>
                                <li class="pl-2">Spiritual guidance and prayer support</li>
                                <li class="pl-2">Family counseling and caregiver assistance</li>
                                <li class="pl-2">End-of-life care and support</li>
                                <li class="pl-2">Ambulance and referral transport services</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 2 -->
        <div class="pmc-acc-item bg-white rounded-xl shadow-[0_3px_6px_rgba(0,0,0,0.18)]">
            <button type="button" class="pmc-acc-btn w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-5 text-left" aria-expanded="false">
                <span class="font-cormorant text-xl sm:text-2xl lg:text-[28px] font-semibold text-navy leading-tight">Home Care Services</span>
                <svg class="pmc-acc-icon shrink-0 w-4 h-4 sm:w-5 sm:h-5 text-black transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 6h16l-8 9z" /></svg>
            </button>
            <div class="pmc-acc-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
                <div class="overflow-hidden">
                    <div class="font-lato px-5 sm:px-6 pb-6 space-y-4 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <p class="font-bold text-navy">Bringing Compassionate Care to the Doorstep</p>
                        <p>
                            Understanding that many seriously ill patients are unable to travel due to weakness, pain, or financial hardship, the Centre extends its services through a dedicated Home Care Program. Medical and palliative care teams regularly visit homes in villages and rural communities to provide compassionate care within the comfort of patients&rsquo; homes.
                        </p>
                        <div>
                            <h4 class="font-bold text-navy mb-2">Home Care Support Includes</h4>
                            <ul class="list-disc pl-5 sm:pl-6 md:columns-2 md:gap-10 space-y-1">
                                <li class="pl-2">Medical examinations and follow-up care</li>
                                <li class="pl-2">Nursing care and wound dressing</li>
                                <li class="pl-2">Pain management and symptom control</li>
                                <li class="pl-2">Distribution of medicines and medical equipment</li>
                                <li class="pl-2">Counseling and emotional support</li>
                                <li class="pl-2">Guidance for caregivers and family members</li>
                                <li class="pl-2">Home-based palliative and end-of-life care</li>
                            </ul>
                        </div>
                        <p>
                            These visits provide not only medical support, but also emotional reassurance, comfort, and hope to families facing difficult circumstances.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 3 -->
        <div class="pmc-acc-item bg-white rounded-xl shadow-[0_3px_6px_rgba(0,0,0,0.18)]">
            <button type="button" class="pmc-acc-btn w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-5 text-left" aria-expanded="false">
                <span class="font-cormorant text-xl sm:text-2xl lg:text-[28px] font-semibold text-navy leading-tight">Pharmacy Services</span>
                <svg class="pmc-acc-icon shrink-0 w-4 h-4 sm:w-5 sm:h-5 text-black transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 6h16l-8 9z" /></svg>
            </button>
            <div class="pmc-acc-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
                <div class="overflow-hidden">
                    <div class="font-lato px-5 sm:px-6 pb-6 space-y-4 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <div>
                            <p class="mb-2">The Centre operates a dedicated pharmacy that supplies medicines for:</p>
                            <ul class="list-disc pl-5 sm:pl-6 space-y-1">
                                <li class="pl-2">Inpatients</li>
                                <li class="pl-2">Home care patients</li>
                                <li class="pl-2">Outside patients and the general public</li>
                            </ul>
                        </div>
                        <p>
                            Medicines for palliative care patients are provided <strong class="font-bold text-navy">free of charge</strong>, while concessional rates are offered to others.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 4 -->
        <div class="pmc-acc-item bg-white rounded-xl shadow-[0_3px_6px_rgba(0,0,0,0.18)]">
            <button type="button" class="pmc-acc-btn w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-5 text-left" aria-expanded="false">
                <span class="font-cormorant text-xl sm:text-2xl lg:text-[28px] font-semibold text-navy leading-tight">Modern Kitchen and Nutritional Care</span>
                <svg class="pmc-acc-icon shrink-0 w-4 h-4 sm:w-5 sm:h-5 text-black transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 6h16l-8 9z" /></svg>
            </button>
            <div class="pmc-acc-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
                <div class="overflow-hidden">
                    <div class="font-lato px-5 sm:px-6 pb-6 space-y-4 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <div>
                            <p class="mb-2">An in-house modern kitchen facility prepares hygienic and nutritious meals for:</p>
                            <ul class="list-disc pl-5 sm:pl-6 space-y-1">
                                <li class="pl-2">Patients</li>
                                <li class="pl-2">Bystanders</li>
                                <li class="pl-2">Staff members on duty</li>
                            </ul>
                        </div>
                        <p>
                            Special attention is given to dietary needs, nutrition, cleanliness, and quality food preparation.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 5 -->
        <div class="pmc-acc-item bg-white rounded-xl shadow-[0_3px_6px_rgba(0,0,0,0.18)]">
            <button type="button" class="pmc-acc-btn w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-5 text-left" aria-expanded="false">
                <span class="font-cormorant text-xl sm:text-2xl lg:text-[28px] font-semibold text-navy leading-tight">Skilled Medical Team and Support Staff</span>
                <svg class="pmc-acc-icon shrink-0 w-4 h-4 sm:w-5 sm:h-5 text-black transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 6h16l-8 9z" /></svg>
            </button>
            <div class="pmc-acc-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
                <div class="overflow-hidden">
                    <div class="font-lato px-5 sm:px-6 pb-6 space-y-4 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                        <div>
                            <p class="mb-2">The Centre is supported by a committed and experienced multidisciplinary team comprising:</p>
                            <ul class="list-disc pl-5 sm:pl-6 space-y-1">
                                <li class="pl-2"><strong class="font-bold text-navy">3</strong> Doctors</li>
                                <li class="pl-2"><strong class="font-bold text-navy">15</strong> Nurses</li>
                                <li class="pl-2">Caregivers and supporting staff</li>
                                <li class="pl-2">Counselors and volunteers</li>
                            </ul>
                        </div>
                        <p>
                            In total, more than <strong class="font-bold text-navy">70 dedicated staff members</strong> work together to provide compassionate and professional care.
                        </p>
                        <p>
                            The entire premises is maintained in a neat, peaceful, hygienic, and patient-friendly manner, supported by courteous and caring staff members.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ================= HOLISTIC CARE & SUPPORTERS (CURVED IMAGE BLOCKS) ================= -->
<section class="bg-[#FAF0DE] pb-14 sm:pb-16 lg:pb-24 overflow-hidden space-y-14 lg:space-y-16">

    <!-- ================= BLOCK 1: HOLISTIC PHILOSOPHY OF CARE (LEFT BLEED, RIGHT CURVE) ================= -->
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
        <div class="w-full lg:w-[46%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[340px] lg:h-[320px] xl:h-[340px] rounded-r-full overflow-hidden">
                <img src="/images/peace-mission-holistic-care.png"
                     alt="A nurse holding hands with an elderly woman in a wheelchair"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[54%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-24" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-2xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-4">
                    Holistic Philosophy of Care
                </h2>
                <div class="font-lato space-y-5 text-sm sm:text-[15px] md:text-base text-[#1E1E1E]/85 leading-relaxed">
                    <p>
                        At the heart of the Guardian Angel Peace Mission Centre is a holistic philosophy that recognizes the physical, emotional, psychological, social, and spiritual dimensions of human life.
                    </p>
                    <p>
                        The Center believes that healing extends beyond medicine. Compassionate listening, emotional support, human companionship, and spiritual comfort are equally important in helping patients experience peace and dignity.<br />
                        Every patient is treated with unconditional love, respect, and compassion.<br />
                        Community Outreach and Humanitarian Service.
                    </p>
                    <div>
                        <p>Over the years, the Center has become a source of hope and support for hundreds of patients and families through:</p>
                        <ul class="list-disc pl-5 sm:pl-6">
                            <li class="pl-2 sm:pl-5">Residential palliative cancer care</li>
                            <li class="pl-2 sm:pl-5">Home-based palliative and nursing services</li>
                            <li class="pl-2 sm:pl-5">Medical and emotional support initiatives</li>
                            <li class="pl-2 sm:pl-5">Counseling and caregiver support</li>
                            <li class="pl-2 sm:pl-5">Community awareness programs</li>
                            <li class="pl-2 sm:pl-5">Assistance for economically vulnerable patients</li>
                        </ul>
                    </div>
                    <p>
                        The Center serves many individuals who otherwise lack access to compassionate healthcare and dignified support during serious illness.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= BLOCK 2: SUPPORTED BY COMPASSION AND GENEROSITY (RIGHT BLEED, LEFT CURVE) ================= -->
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
