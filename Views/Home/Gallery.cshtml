@{
    ViewData["Title"] = "Gallery";
    ViewData["HeaderClass"] = "shadow-sm";
}

<!-- ================= GALLERY SECTION ================= -->
<section class="py-12 md:py-20 bg-white mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Gallery Grid Container -->
    <div id="gallery-container" class="space-y-4 sm:space-y-6">

      <!-- ================= DEFAULT VISIBLE BATCH ================= -->
      
      <!-- Row 1: Top Asymmetric 3-Column Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6">
        <!-- Item 0: Auditorium Audience (Wide) -->
        <div class="md:col-span-5 h-64 sm:h-72 md:h-80 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(0)" data-aos="fade-up" data-aos-delay="100">
          <img src="/images/gallery-img-1.png" alt="Auditorium Event" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <!-- Item 1: Auditorium Stage View -->
        <div class="md:col-span-4 h-64 sm:h-72 md:h-80 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(1)" data-aos="fade-up" data-aos-delay="200">
          <img src="/images/gallery-img-1.png" alt="Auditorium Stage View" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <!-- Item 2: Community Gathering (Portrait) -->
        <div class="md:col-span-3 h-64 sm:h-72 md:h-80 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(2)" data-aos="fade-up" data-aos-delay="300">
          <img src="/images/gallery-img-2.png" alt="Community Gathering" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
      </div>

      <!-- Row 2: Middle 3-Column Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6">
        <!-- Item 3: Video Call Screen -->
        <div class="md:col-span-3 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(3)" data-aos="fade-up" data-aos-delay="100">
          <img src="/images/gallery-img-3.png" alt="Video Call Screen" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <!-- Item 4: Hands on Laptop (Wide Center) -->
        <div class="md:col-span-5 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(4)" data-aos="fade-up" data-aos-delay="200">
          <img src="/images/gallery-img-4.png" alt="Hands on Laptop" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <!-- Item 5: Office Desk Video Chat -->
        <div class="md:col-span-4 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(5)" data-aos="fade-up" data-aos-delay="300">
          <img src="/images/gallery-img-5.png" alt="Office Desk Video Chat" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
      </div>

      <!-- Row 3: Bottom 3-Column Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6">
        <!-- Item 6: Video Call Hands Pointing -->
        <div class="md:col-span-3 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(6)" data-aos="fade-up" data-aos-delay="100">
          <img src="/images/gallery-img-3.png" alt="Video Call Hands Pointing" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <!-- Item 7: Collaborative Laptop Work -->
        <div class="md:col-span-5 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(7)" data-aos="fade-up" data-aos-delay="200">
          <img src="/images/gallery-img-4.png" alt="Collaborative Laptop Work" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <!-- Item 8: Desk Video Conference -->
        <div class="md:col-span-4 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(8)" data-aos="fade-up" data-aos-delay="300">
          <img src="/images/gallery-img-5.png" alt="Desk Video Conference" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
      </div>

      <!-- ================= EXTRA IMAGES BATCH (HIDDEN BY DEFAULT FOR SEE ALL) ================= -->
      <div id="extra-gallery-items" class="hidden space-y-4 sm:space-y-6 pt-4 sm:pt-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6">
          <div class="md:col-span-3 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(9)">
            <img src="/images/gallery-img-3.png" alt="Additional Video Call" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="md:col-span-5 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(10)">
            <img src="/images/gallery-img-4.png" alt="Additional Team Work" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="md:col-span-4 h-52 sm:h-60 rounded-2xl overflow-hidden cursor-pointer group shadow-sm" onclick="openLightbox(11)">
            <img src="/images/gallery-img-5.png" alt="Additional Healthcare Staff" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
        </div>
      </div>

    </div>

    <!-- See All / See Less Button -->
    <div class="mt-12 text-center" data-aos="fade-up" data-aos-delay="100">
      <button 
        id="toggle-gallery-btn" 
        onclick="toggleSeeAll()" 
        class="font-lato inline-flex items-center gap-2 bg-navy hover:bg-[#121f42] text-white px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all shadow-md hover:shadow-lg"
      >
        <span id="see-all-text">See All Images</span>
        <svg id="see-all-icon" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>

  </div>
</section>

<!-- ================= FULLSCREEN LIGHTBOX MODAL ================= -->
<div 
  id="lightbox-modal" 
  class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm hidden flex flex-col justify-between p-4 sm:p-6 select-none"
  onclick="handleBackdropClick(event)"
>
  <!-- Header Controls -->
  <div class="flex items-center justify-between text-white w-full max-w-7xl mx-auto z-10">
    <span id="lightbox-counter" class="font-lato text-xs sm:text-sm text-gray-300 tracking-wider">
      1 / 12
    </span>

    <div class="flex items-center gap-2 sm:gap-3">
      <button onclick="zoomIn()" class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors" title="Zoom In">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
      </button>
      <button onclick="zoomOut()" class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors" title="Zoom Out">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
      </button>
      <button onclick="resetZoom()" class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors" title="Reset Zoom">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      </button>
      <button onclick="closeLightbox()" class="p-2 rounded-full bg-white/10 hover:bg-red-500/80 text-white transition-colors ml-2" title="Close">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>

  <!-- Center Image Area -->
  <div class="relative flex-1 flex items-center justify-center overflow-hidden w-full max-w-7xl mx-auto my-auto">
    <!-- Prev -->
    <button onclick="prevImage(event)" class="absolute left-2 sm:left-4 z-20 p-3 rounded-full bg-black/40 hover:bg-black/70 text-white transition-colors focus:outline-none" title="Previous Image">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
    </button>

    <!-- Main Lightbox Image -->
    <div class="max-h-[82vh] max-w-full flex items-center justify-center overflow-hidden">
      <img id="lightbox-img" src="" alt="Expanded Gallery View" class="max-h-[80vh] max-w-[90vw] object-contain transition-transform duration-200 cursor-grab" />
    </div>

    <!-- Next -->
    <button onclick="nextImage(event)" class="absolute right-2 sm:right-4 z-20 p-3 rounded-full bg-black/40 hover:bg-black/70 text-white transition-colors focus:outline-none" title="Next Image">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>

  <!-- Footer Help Info -->
  <div class="text-center text-xs text-gray-400 font-lato z-10">
    Keyboard arrow keys (← / →) upayogichum navigate cheyyam, Esc key adichaal close aakum
  </div>
</div>

@section Scripts {
<script>
  const galleryImages = [
    "/images/gallery-img-1.png",
    "/images/gallery-img-1.png",
    "/images/gallery-img-2.png",
    "/images/gallery-img-3.png",
    "/images/gallery-img-4.png",
    "/images/gallery-img-5.png",
    "/images/gallery-img-3.png",
    "/images/gallery-img-4.png",
    "/images/gallery-img-5.png",
    "/images/gallery-img-3.png",
    "/images/gallery-img-4.png",
    "/images/gallery-img-5.png"
  ];

  let currentImgIndex = 0;
  let zoomLevel = 1;

  function openLightbox(index) {
    currentImgIndex = index;
    zoomLevel = 1;
    updateLightbox();
    
    const modal = document.getElementById('lightbox-modal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    const modal = document.getElementById('lightbox-modal');
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
    resetZoom();
  }

  function updateLightbox() {
    const imgElement = document.getElementById('lightbox-img');
    const counter = document.getElementById('lightbox-counter');
    
    imgElement.src = galleryImages[currentImgIndex];
    counter.innerText = `${currentImgIndex + 1} / ${galleryImages.length}`;
    applyZoom();
  }

  function nextImage(e) {
    if (e) e.stopPropagation();
    currentImgIndex = (currentImgIndex + 1) % galleryImages.length;
    resetZoom();
    updateLightbox();
  }

  function prevImage(e) {
    if (e) e.stopPropagation();
    currentImgIndex = (currentImgIndex - 1 + galleryImages.length) % galleryImages.length;
    resetZoom();
    updateLightbox();
  }

  function zoomIn() {
    if (zoomLevel < 3) {
      zoomLevel += 0.25;
      applyZoom();
    }
  }

  function zoomOut() {
    if (zoomLevel > 0.75) {
      zoomLevel -= 0.25;
      applyZoom();
    }
  }

  function resetZoom() {
    zoomLevel = 1;
    applyZoom();
  }

  function applyZoom() {
    const imgElement = document.getElementById('lightbox-img');
    imgElement.style.transform = `scale(${zoomLevel})`;
  }

  function handleBackdropClick(e) {
    if (e.target.id === 'lightbox-modal' || e.target.tagName === 'DIV') {
      if (!e.target.closest('#lightbox-img') && !e.target.closest('button')) {
        closeLightbox();
      }
    }
  }

  document.addEventListener('keydown', function(e) {
    const modal = document.getElementById('lightbox-modal');
    if (!modal.classList.contains('hidden')) {
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'Escape') closeLightbox();
    }
  });

  function toggleSeeAll() {
    const extraItems = document.getElementById('extra-gallery-items');
    const btnText = document.getElementById('see-all-text');
    const icon = document.getElementById('see-all-icon');

    if (extraItems.classList.contains('hidden')) {
      extraItems.classList.remove('hidden');
      btnText.innerText = 'See Less';
      icon.style.transform = 'rotate(180deg)';
    } else {
      extraItems.classList.add('hidden');
      btnText.innerText = 'See All Images';
      icon.style.transform = 'rotate(0deg)';
      document.getElementById('gallery-container').scrollIntoView({ behavior: 'smooth' });
    }

    // Refresh AOS calculation when extra items are revealed or hidden
    if (typeof AOS !== 'undefined') {
      AOS.refresh();
    }
  }
</script>
}
