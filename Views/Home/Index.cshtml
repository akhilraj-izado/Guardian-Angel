          </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300" data-aos="fade-up" data-aos-delay="250">
          <img src="/images/img-mission-4.png" alt="Institutions rooted in ethical values" class="w-full h-36 sm:h-40 object-cover rounded-t-2xl" />
          <div class="p-4 sm:p-5 flex-1 flex items-center justify-center text-center">
