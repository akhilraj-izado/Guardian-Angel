            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= OUR SERVICES ================= -->
  <section class="py-16 md:py-24 bg-[#fafbfc]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">

      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16" data-aos="fade-up">
        <p class="text-sm sm:text-base font-bold tracking-[0.25em] uppercase text-navy">
