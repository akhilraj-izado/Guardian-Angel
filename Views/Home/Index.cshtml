          <img src="/images/img-mission-3.png" alt="Education and empowerment" class="w-full h-36 sm:h-40 object-cover rounded-t-2xl" />
          <div class="p-4 sm:p-5 flex-1 flex items-center justify-center text-center">
            <p class="text-sm sm:text-base font-medium leading-snug">
              To promote education and social empowerment
            </p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300" data-aos="fade-up" data-aos-delay="250">
          <img src="/images/img-mission-4.png" alt="Institutions rooted in ethical values" class="w-full h-36 sm:h-40 object-cover rounded-t-2xl" />
          <div class="p-4 sm:p-5 flex-1 flex items-center justify-center text-center">
            <p class="text-sm sm:text-base font-medium leading-snug">
              To create institutions rooted in ethical and humanitarian values
            </p>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300" data-aos="fade-up" data-aos-delay="300">
          <img src="/images/img-mission-5.png" alt="Ethical values" class="w-full h-36 sm:h-40 object-cover rounded-t-2xl" />
          <div class="p-4 sm:p-5 flex-1 flex items-center justify-center text-center">
            <p class="text-sm sm:text-base font-medium leading-snug">
              To create institutions rooted in ethical and humanitarian values
            </p>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300" data-aos="fade-up" data-aos-delay="350">
          <img src="/images/img-mission-6.png" alt="Care without discrimination" class="w-full h-36 sm:h-40 object-cover rounded-t-2xl" />
          <div class="p-4 sm:p-5 flex-1 flex items-center justify-center text-center">
