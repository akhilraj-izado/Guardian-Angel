@{
    ViewData["Title"] = null;
}

@section Styles {
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@@11/swiper-bundle.min.css" />
}

  <!-- ================= HERO ================= -->
  <section class="relative z-30 bg-white md:min-h-[75vh] lg:min-h-[90vh]">
    <div class="hidden md:block absolute inset-0 bg-[url('/images/first-bg.png')] bg-cover bg-left-bottom"></div>
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-white/90"></div>

    <img src="/images/hero.png" alt="A caregiver embracing an elderly woman" class="md:hidden w-full h-auto" />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-12 md:pt-24 md:pb-28 lg:pt-32 lg:pb-36 flex md:justify-end">
      <div class="w-full md:w-1/2 lg:w-[44%]" data-aos="fade-left" data-aos-duration="1000">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight">
          <span class="text-sky">Bringing</span> Hope,<br />
          Healing, <span class="text-sky">&amp;</span> Dignity<br />
          <span class="text-sky">to Humanity</span>
        </h1>

        <p class="mt-4 text-xl sm:text-2xl font-medium" data-aos="fade-left" data-aos-delay="150">Compassion in Action Since 1985</p>

        <p class="font-lato mt-4 text-base sm:text-lg leading-relaxed max-w-md text-navy/90 font-normal" data-aos="fade-left" data-aos-delay="250">
          For over 40 years, Guardian Angel Care Charitable Society has been serving orphaned children,
          the elderly, the sick, and vulnerable communities through healthcare, education, and compassionate care.
        </p>

        <div class="font-lato mt-8 flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="350">
          <a href="#" class="inline-flex items-center justify-center rounded-full bg-navy text-white px-7 py-2.5 text-sm font-bold uppercase tracking-wide hover:bg-sky transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky focus-visible:ring-offset-2">
            Donate Now
          </a>
          <a href="#" class="inline-flex items-center justify-center rounded-full border border-navy text-navy px-6 py-2.5 text-sm font-bold uppercase tracking-wide hover:bg-navy hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky focus-visible:ring-offset-2">
            Become a Member
          </a>
        </div>
      </div>
    </div>

    <!-- ================= STATS BAR ================= -->
    <div class="absolute bottom-0 left-0 right-0 translate-y-1/2 z-40 px-4 sm:px-6 lg:px-10">
      <div 
        class="max-w-6xl mx-auto bg-navy text-white rounded-sm shadow-2xl border-4 border-sky/30"
        data-aos="fade-up" 
        data-aos-delay="200" 
        data-aos-duration="800"
      >
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-white/20 py-4 lg:py-6">
          <li class="flex items-center gap-3 px-5 lg:px-6 py-3">
            <img src="/images/icon-calendar.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <div>
              <p class="text-2xl lg:text-3xl font-bold leading-none">40+</p>
              <p class="text-xs lg:text-sm font-bold text-white leading-tight mt-1">Years of<br />Service</p>
            </div>
          </li>
          <li class="flex items-center gap-3 px-5 lg:px-6 py-3">
            <img src="/images/icon-lives.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <div>
              <p class="text-2xl lg:text-3xl font-bold leading-none">5000+</p>
              <p class="text-xs lg:text-sm font-bold text-white leading-tight mt-1">Lives<br />Supported</p>
            </div>
          </li>
          <li class="flex items-center gap-3 px-5 lg:px-6 py-3">
            <img src="/images/icon-families.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <div>
              <p class="text-2xl lg:text-3xl font-bold leading-none">1000+</p>
              <p class="text-xs lg:text-sm font-bold text-white leading-tight mt-1">Families<br />Supported</p>
            </div>
          </li>
          <li class="flex items-center gap-3 px-5 lg:px-6 py-3">
            <img src="/images/icon-programs.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <div>
              <p class="text-2xl lg:text-3xl font-bold leading-none">20+</p>
              <p class="text-xs lg:text-sm font-bold text-white leading-tight mt-1">Community<br />Programs</p>
            </div>
          </li>
          <li class="col-span-2 sm:col-span-1 flex items-center gap-3 px-5 lg:px-6 py-3">
            <img src="/images/icon-volunteer.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <div>
              <p class="text-2xl lg:text-3xl font-bold leading-none">Thousands</p>
              <p class="text-xs lg:text-sm font-bold text-white leading-tight mt-1">of Volunteer<br />Hours</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT / MISSION ================= -->
<section class="relative z-10 bg-white overflow-hidden">
    <div class="hidden md:block absolute inset-0 bg-[url('/images/second-bg.png')] bg-cover bg-right"></div>
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-24 sm:pt-28 md:pt-32 pb-16 md:pb-24 lg:pb-28">
      <div class="w-full md:w-[55%] lg:w-1/2" data-aos="fade-right" data-aos-duration="900">
        <p class="text-base sm:text-lg font-semibold uppercase tracking-wider">
          About <span class="text-sky">Us</span>
        </p>
        <h2 class="mt-1 text-3xl sm:text-4xl font-semibold uppercase">Our Mission</h2>

        <div class="font-lato mt-6 space-y-3 text-base sm:text-lg leading-relaxed">
          <p>
            We are committed to advancing inclusive and sustainable community development by serving orphaned
            children, the destitute, the elderly, the terminally ill, and individuals in need of mental healthcare.
          </p>
          <p>
            Through structured care programmes, accessible quality education, vocational training, and
            compassionate palliative and geriatric services, we create measurable social impact and sustainable
            pathways to dignity, independence, and long-term resilience.
          </p>
        </div>

        <!-- Values -->
        <ul class="mt-10 grid grid-cols-3 sm:grid-cols-5 gap-y-6 gap-x-4 max-w-xl">
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="100">
            <img src="/images/icon-compassion.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Compassion</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="200">
            <img src="/images/icon-inclusion.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Inclusion</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="300">
            <img src="/images/icon-care.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Care</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="400">
            <img src="/images/icon-education.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Education</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="500">
            <img src="/images/icon-service.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Faith &amp; Service</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Image (mobile) -->
    <img src="/images/mission.png" alt="A volunteer holding hands with an elderly woman during a community meal" class="md:hidden w-full h-auto" />
  </section>

