        </p>
        <h2 class="mt-2 text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-semibold text-navy uppercase tracking-wide leading-tight">
          Care That Heals. Program That Transforms
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">

        <!-- Service 1 -->
        <div class="bg-white rounded-xl shadow-[0_4px_25px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col sm:flex-row hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="100">
          <div class="sm:w-1/2 h-56 sm:h-auto shrink-0">
            <img src="/images/img-service-1.png" alt="Healthcare & Rehabilitation" class="w-full h-full object-cover" />
          </div>
          <div class="sm:w-1/2 p-6 sm:p-7 flex flex-col justify-center">
            <h3 class="text-xl sm:text-2xl font-bold text-navy">
              Healthcare &amp; Rehabilitation
            </h3>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-[#5E788C]">
              Providing compassionate healthcare and rehabilitation services that restore health, hope, and dignity to vulnerable individuals and communities.
            </p>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="bg-white rounded-xl shadow-[0_4px_25px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col sm:flex-row hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="200">
          <div class="sm:w-1/2 h-56 sm:h-auto shrink-0">
            <img src="/images/img-service-2.png" alt="Elderly & Palliative Care" class="w-full h-full object-cover" />
          </div>
          <div class="sm:w-1/2 p-6 sm:p-7 flex flex-col justify-center">
            <h3 class="text-xl sm:text-2xl font-bold text-navy">
