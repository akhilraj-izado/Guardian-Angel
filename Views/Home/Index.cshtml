        </div>
        <p class="font-lato text-xs sm:text-[13px] font-medium text-black leading-snug">
          Elder care and<br />geriatric services
        </p>
      </div>

      <!-- Item 2: Palliative and hospice care -->
      <div class="flex flex-col items-center text-center px-2 sm:px-3 lg:border-r border-[#3a5378]/25 lg:h-full group">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#BEE1F9] flex items-center justify-center p-3 sm:p-4 mb-3.5 shadow-sm transition-transform duration-300 group-hover:scale-105">
          <img src="images/Navy Hand Holding Glossy Heart.png" alt="Palliative and Hospice Care" class="w-full h-full object-contain" />
        </div>
        <p class="font-lato text-xs sm:text-[13px] font-medium text-black leading-snug">
          Palliative and<br />hospice care
        </p>
      </div>

      <!-- Item 3: Mental health support -->
