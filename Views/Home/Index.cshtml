        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#BEE1F9] flex items-center justify-center p-3 sm:p-4 mb-3.5 shadow-sm transition-transform duration-300 group-hover:scale-105">
          <img src="images/Navy Brain Head Silhouette.png" alt="Mental Health Support" class="w-full h-full object-contain" />
        </div>
