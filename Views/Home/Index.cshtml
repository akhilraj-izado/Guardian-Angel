        <div class="bg-white rounded-xl shadow-[0_4px_25px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col sm:flex-row hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="400">
          <div class="sm:w-1/2 h-56 sm:h-auto shrink-0">
