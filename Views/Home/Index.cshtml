      </div>
    </div>
  </section>

  <!-- ================= ABOUT / MISSION ================= -->
<section class="relative z-10 bg-white overflow-hidden">
    <div class="hidden md:block absolute inset-0 bg-[url('/images/Bright-Clinical-Ward-with-Caring-Nurses.png')] bg-cover bg-right"></div>
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent"></div>

    <!-- Image with heading overlaid (mobile only) -->
    <div class="md:hidden px-4 sm:px-6 pt-10 sm:pt-12" data-aos="fade-down" data-aos-duration="800">
      <div class="relative rounded-2xl overflow-hidden shadow-md">
        <img src="/images/Bright-Clinical-Ward-with-Caring-Nurses.png" alt="Nurses caring for patients in a bright clinical ward" class="w-full h-60 sm:h-80 object-cover object-right" />
        <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/60 via-45% to-transparent pointer-events-none"></div>
        <div class="absolute inset-y-0 left-0 w-3/5 flex flex-col justify-center pl-4 sm:pl-8 pr-2">
          <p class="text-sm sm:text-lg font-semibold uppercase tracking-wider">
            About <span class="text-sky">Us</span>
          </p>
          <h2 class="mt-1 text-2xl sm:text-4xl font-semibold uppercase leading-tight">Our Mission</h2>
        </div>
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-8 sm:pt-10 md:pt-32 pb-12 md:pb-24 lg:pb-28">
      <div class="w-full md:w-[55%] lg:w-1/2" data-aos="fade-right" data-aos-duration="900">
        <p class="hidden md:block text-base sm:text-lg font-semibold uppercase tracking-wider">
          About <span class="text-sky">Us</span>
        </p>
        <h2 class="hidden md:block mt-1 text-3xl sm:text-4xl font-semibold uppercase">Our Mission</h2>

        <div class="font-lato md:mt-6 space-y-3 text-base sm:text-lg leading-relaxed">
          <p>
            We are committed to advancing inclusive and sustainable community development by serving orphaned children, the destitute, the elderly, the terminally ill, and individuals in need of mental healthcare.
          </p>
          <p>
            Through structured care programmes, accessible quality education, vocational training, and
compassionate palliative and geriatric services, we create measurable social impact and sustainable pathways to dignity, independence, and long-term resilience.

          </p>
        </div>

        <!-- Values -->
        <ul class="mt-10 grid grid-cols-3 sm:grid-cols-5 gap-y-6 gap-x-4 max-w-xl">
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="100">
            <img src="/images/icon-compassion.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Compassion</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="200">
            <img src="/images/icon-inclusion.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Inclusion</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="300">
            <img src="/images/icon-care.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Care</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="400">
            <img src="/images/icon-education.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Education</span>
          </li>
          <li class="flex flex-col items-center text-center gap-2" data-aos="fade-up" data-aos-delay="500">
            <img src="/images/icon-service.png" alt="" class="w-8 h-8 object-contain shrink-0" />
            <span class="text-black font-semibold">Faith &amp; Service</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= OUR MISSION GOALS ================= -->
