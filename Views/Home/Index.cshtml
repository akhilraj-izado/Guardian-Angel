            </h3>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-[#5E788C]">
              Providing compassionate healthcare and rehabilitation services that restore health, hope, and dignity to vulnerable individuals and communities.
            </p>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="bg-white rounded-xl shadow-[0_4px_25px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col sm:flex-row hover:shadow-md transition-shadow" data-aos="fade-up" data-aos-delay="300">
          <div class="sm:w-1/2 h-56 sm:h-auto shrink-0">
            <img src="/images/img-service-3.png" alt="Education & Scholarships" class="w-full h-full object-cover" />
          </div>
          <div class="sm:w-1/2 p-6 sm:p-7 flex flex-col justify-center">
            <h3 class="text-xl sm:text-2xl font-bold text-navy">
              Education &amp; Scholarships
            </h3>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-[#5E788C]">
              Providing compassionate healthcare and rehabilitation services that restore health, hope, and dignity to vulnerable individuals and communities.
            </p>
          </div>
        </div>

