@{
    ViewData["Title"] = "Projects";
}

<!-- ================= PROJECTS PAGE HERO SECTION ================= -->
<section class="relative z-30 bg-white mb-24 sm:mb-28 lg:mb-32 overflow-visible md:min-h-[75vh] lg:min-h-[90vh] flex flex-col justify-center">
  
  <!-- Desktop Background Image (Right Aligned Hands Holding Red Heart) -->
  <div 
    class="hidden md:block absolute inset-0 bg-cover bg-no-repeat bg-right"
    style="background-image: url('/images/projects-hero-bg.png');"
  ></div>
  
  <!-- Soft Gradient Overlay for Text Readability -->
  <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white via-white/85 to-transparent"></div>

  <!-- Mobile Top Image -->
  <img 
    src="/images/projects-hero-bg.png" 
    alt="Cupped hands protecting a red heart" 
    class="md:hidden w-full h-auto object-cover"
  />

  <!-- Main Hero Content (Vertically Centered) -->
  <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-12 md:py-16 pb-28 sm:pb-32 md:pb-36 lg:pb-40">
    <div class="w-full md:w-[60%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900">
      
      <!-- Small Category Tag -->
      <p class="font-cormorant text-sm sm:text-base font-bold uppercase tracking-[0.25em] text-sky">
        Our <span class="text-navy">Projects</span>
      </p>

      <!-- Main Heading -->
      <h1 class="font-cormorant mt-2 text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wide text-navy leading-[1.2]">
        Projects of Compassion,<br />Hope &amp; Care
      </h1>

      <!-- Description Paragraphs in Lato font -->
      <div class="font-lato mt-5 space-y-4 text-[#1E1E1E] text-xs sm:text-sm md:text-base leading-relaxed max-w-xl">
        <p>
          Guardian Angel Care Charitable Society began as a small charitable initiative inspired by compassion for the poor and suffering. Over nearly four decades, the Society has expanded into a multifaceted humanitarian organization serving thousands of individuals across Kerala.
        </p>
        <p>
          What began with prayer, spiritual preparation, and a dream of service has today become a trusted institution.
        </p>
      </div>

    </div>
  </div>

  <!-- ================= FLOATING FEATURE BAR (7 ITEMS WITH SKY BLUE DIVIDERS) ================= -->
  <div class="absolute bottom-0 left-0 right-0 translate-y-1/2 z-40 px-3 sm:px-6 lg:px-8 pointer-events-none">
