          <img src="/images/icon-group.png" alt="Educational institutions" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-xs sm:text-sm lg:text-[15px] font-semibold text-navy leading-tight">
            Educational<br />institutions
          </p>
        </li>

        <!-- Item 4: Palliative & hospital care -->
