      class="max-w-7xl mx-auto bg-white rounded-[26px] sm:rounded-3xl shadow-[0_10px_35px_rgba(0,0,0,0.06)] border border-[#76B2E1]/40 py-5 sm:py-6 px-3 sm:px-5 pointer-events-auto"
      data-aos="fade-up"
      data-aos-delay="150"
      data-aos-duration="800"
    >
      
      <!-- Grid with 7 Columns for Projects Services -->
      <ul class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 divide-y sm:divide-y-0 sm:divide-x divide-[#76B2E1]/60">
        
        <!-- Item 1: Elder care & geriatric services -->
        <li class="flex flex-col items-center justify-center text-center p-2.5 sm:px-2">
          <img src="/images/icon-care-2.png" alt="Elder care & geriatric services" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-xs sm:text-sm lg:text-[15px] font-semibold text-navy leading-tight">
            Elder care &amp;<br />geriatric services
          </p>
