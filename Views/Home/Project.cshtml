        <!-- Item 7: Spiritual & retreat ministries -->
        <li class="col-span-2 sm:col-span-2 lg:col-span-1 flex flex-col items-center justify-center text-center p-2.5 sm:px-2">
          <img src="/images/icon-cross.png" alt="Spiritual & retreat ministries" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-xs sm:text-sm lg:text-[15px] font-semibold text-navy leading-tight">
            Spiritual &amp; retreat<br />ministries
          </p>
        </li>

      </ul>
    </div>
  </div>

</section>

