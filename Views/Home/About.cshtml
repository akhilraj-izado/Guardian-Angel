@{
    ViewData["Title"] = "About";
}

@section Styles {
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@@11/swiper-bundle.min.css" />
}

<!-- ================= ABOUT PAGE HERO SECTION ================= -->
<section class="relative z-30 bg-[#FAF6ED] mb-24 sm:mb-28 lg:mb-32 overflow-visible md:min-h-[75vh] lg:min-h-[88vh]">
  
  <!-- Desktop Background Image (Right Aligned) -->
  <div 
    class="hidden md:block absolute inset-0 bg-cover bg-no-repeat bg-right"
    style="background-image: url('/images/about-hero-bg.png');"
  ></div>
  
  <!-- Soft Gradient Overlay for Text Readability -->
  <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-[#FAF6ED] via-[#FAF6ED]/85 to-transparent"></div>

  <!-- Mobile Top Image -->
  <img 
    src="/images/about-hero-bg.png" 
    alt="Caregiver smiling with elderly woman" 
    class="md:hidden w-full h-auto object-cover"
  />

  <!-- Main Hero Content -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-10 pb-28 sm:pb-36 md:py-16 md:pb-24 lg:pb-28 md:min-h-[75vh] lg:min-h-[88vh] flex items-center">
    <div class="w-full md:w-[60%] lg:w-[50%]" data-aos="fade-right" data-aos-duration="900">
      
      <!-- Small Category Tag -->
      <p class="font-cormorant text-sm sm:text-base font-bold uppercase tracking-[0.25em] text-navy">
        About <span class="text-sky">Us</span>
      </p>

      <!-- Main Heading -->
      <h1 class="font-cormorant mt-2 text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wide text-navy leading-[1.15] whitespace-nowrap">
        Our Story (History &amp; Founding)
      </h1>

      <!-- Description Paragraphs in Lato font -->
      <div class="font-lato mt-5 space-y-4 text-[#1E1E1E] text-sm sm:text-base leading-relaxed max-w-xl">
        <p>
          Established in 1985, Guardian Angel Care Charitable Society is a registered charitable organization functioning under the Travancore–Cochin Literary, Scientific, and Charitable Societies Registration Act, 1955, (Reg. No. ER 101/85 dated 6 March 1985).
        </p>
        <p>
          The Society was founded with a vision to create compassionate spaces for healing, care, education, and social empowerment.
        </p>
      </div>

    </div>
  </div>

  <!-- ================= FLOATING FEATURE BAR ================= -->
  <div class="absolute bottom-0 left-0 right-0 translate-y-1/2 z-40 px-4 sm:px-6 lg:px-10 pointer-events-none">
    <div 
      class="max-w-6xl mx-auto bg-white rounded-[26px] sm:rounded-3xl shadow-[0_10px_35px_rgba(0,0,0,0.06)] border border-[#76B2E1]/40 py-5 sm:py-6 px-3 sm:px-6 pointer-events-auto"
      data-aos="fade-up"
      data-aos-delay="150"
      data-aos-duration="800"
    >
      
      <!-- Grid with Sky Blue Vertical Dividers -->
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-y sm:divide-y-0 sm:divide-x divide-[#76B2E1]/60">
        
        <!-- Item 1: Palliative Care -->
        <li class="flex flex-col items-center justify-center text-center p-3 sm:px-3">
          <img src="/images/icon-care-2.png" alt="Palliative and geriatric care" class="w-10 h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-base sm:text-[17px] font-semibold text-black leading-tight">
            Palliative<br />and geriatric<br />care
          </p>
        </li>

        <!-- Item 2: Mental Healthcare -->
        <li class="flex flex-col items-center justify-center text-center p-3 sm:px-3">
          <img src="/images/icon-support.png" alt="Mental healthcare" class="w-10 h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-base sm:text-[17px] font-semibold text-black leading-tight">
            Mental<br />healthcare &amp;<br />rehabilitation
          </p>
        </li>

        <!-- Item 3: Community Development -->
        <li class="flex flex-col items-center justify-center text-center p-3 sm:px-3">
          <img src="/images/icon-book.png" alt="Community development" class="w-10 h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-base sm:text-[17px] font-semibold text-black leading-tight">
            Community<br />development<br />programmes
          </p>
        </li>

        <!-- Item 4: Education & Child Welfare -->
        <li class="flex flex-col items-center justify-center text-center p-3 sm:px-3">
          <img src="/images/icon-group.png" alt="Education & child welfare" class="w-10 h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-base sm:text-[17px] font-semibold text-black leading-tight">
            Education &amp;<br />child<br />welfare
          </p>
        </li>

        <!-- Item 5: Spiritual Outreach -->
        <li class="flex flex-col items-center justify-center text-center p-3 sm:px-3">
          <img src="/images/icon-cross.png" alt="Spiritual outreach" class="w-10 h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-base sm:text-[17px] font-semibold text-black leading-tight">
            Spiritual &amp;<br />humanitarian<br />outreach
          </p>
        </li>

        <!-- Item 6: Residential Care -->
        <li class="flex flex-col items-center justify-center text-center p-3 sm:px-3">
          <img src="/images/icon-house.png" alt="Residential care" class="w-12 h-10 object-contain" />
          <p class="font-cormorant mt-2.5 text-base sm:text-[17px] font-semibold text-black leading-tight">
            Residential care<br />and support<br />services
          </p>
        </li>

      </ul>
    </div>
  </div>

</section>

<!-- ================= OUR MISSION & VISION SECTION ================= -->
<section class="relative z-10 py-16 md:py-5 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 lg:space-y-8">
    
    <!-- ROW 1: MISSION -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-stretch" data-aos="fade-up" data-aos-duration="900">
      <div class="md:col-span-7 overflow-hidden shadow-sm h-72 sm:h-80 md:h-[350px]">
        <img 
          src="/images/about-mission.png" 
          alt="Community members learning and caring together" 
          class="w-full h-full object-cover"
        />
      </div>

      <div class="md:col-span-5 bg-[#FDEDC9] rounded-2xl p-6 sm:p-8 lg:p-9 flex flex-col justify-center items-center text-center shadow-sm">
        <h3 class="font-cormorant text-2xl sm:text-3xl font-bold uppercase tracking-wide text-navy">
          Our Mission:
        </h3>
        
        <div class="font-lato mt-4 text-xs sm:text-[13.5px] leading-relaxed text-[#1E1E1E]/90 space-y-3">
          <p>
            We are committed to advancing inclusive and sustainable community development by serving orphaned children, the destitute, the elderly, the terminally ill, and individuals in need of mental healthcare.
          </p>
          <p>
            Through structured care programmes, accessible quality education, vocational training, and compassionate palliative and geriatric services, we create measurable social impact and sustainable pathways to dignity, independence, and long-term resilience.
          </p>
        </div>
      </div>
    </div>

    <!-- ROW 2: VISION -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-stretch" data-aos="fade-up" data-aos-duration="900" data-aos-delay="150">
      <div class="order-2 md:order-1 md:col-span-5 bg-[#FDEDC9] rounded-2xl p-6 sm:p-8 lg:p-9 flex flex-col justify-center items-center text-center shadow-sm">
        <h3 class="font-cormorant text-2xl sm:text-3xl font-bold uppercase tracking-wide text-navy mb-4 sm:mb-6">
          Our Vision:
        </h3>
        
        <div class="font-cormorant text-3xl sm:text-4xl md:text-[44px] font-medium text-navy leading-tight">
          <p>Honour <span class="text-sky font-semibold">Life</span></p>
          <p class="mt-1 sm:mt-2">and Offer</p>
          <p class="mt-1 sm:mt-2 text-sky font-semibold">Hope</p>
        </div>
      </div>

      <div class="order-1 md:order-2 md:col-span-7 overflow-hidden shadow-sm h-72 sm:h-80 md:h-[350px]">
        <img 
          src="/images/about-vision.png" 
          alt="Caregivers smiling warmly with elderly lady" 
          class="w-full h-full object-cover"
        />
      </div>
    </div>

  </div>
</section>

<!-- ================= OUR CORE VALUES SLIDER SECTION ================= -->
<section class="py-16 md:py-24 bg-white overflow-hidden" data-aos="fade-up" data-aos-duration="900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">

    <div class="text-center mb-10 md:mb-14">
      <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl font-bold uppercase tracking-[0.15em] text-navy">
        Our Core Values
      </h2>
    </div>

    <div class="swiper valuesSwiper pb-12">
      <div class="swiper-wrapper">

        <!-- Slide 1: COMPASSION -->
        <div class="swiper-slide h-auto">
          <div class="bg-navy text-white rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-compassion-val.png" alt="Compassion" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-white">
              Compassion
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-gray-200">
              We demonstrate empathy and kindness toward every individual while recognizing their inherent worth and dignity.
            </p>
          </div>
        </div>

        <!-- Slide 2: INCLUSIVITY -->
        <div class="swiper-slide h-auto">
          <div class="bg-[#76B2E1] text-navy rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-inclusivity-val.png" alt="Inclusivity" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-navy">
              Inclusivity
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-navy/90 font-medium">
              We embrace diversity and create welcoming environments where all people feel valued and supported.
            </p>
          </div>
        </div>

        <!-- Slide 3: UNCONDITIONAL LOVE -->
        <div class="swiper-slide h-auto">
          <div class="bg-navy text-white rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-love-val.png" alt="Unconditional Love" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-white">
              Unconditional Love
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-gray-200">
              We demonstrate empathy and kindness toward every individual while recognizing their inherent worth and dignity.
            </p>
          </div>
        </div>

        <!-- Slide 4: EMPOWERMENT -->
        <div class="swiper-slide h-auto">
          <div class="bg-[#76B2E1] text-navy rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-empower-val.png" alt="Empowerment" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-navy">
              Empowerment
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-navy/90 font-medium">
              We help individuals achieve their fullest potential through education, support, and opportunity.
            </p>
          </div>
        </div>

        <!-- Slide 5: INTEGRITY -->
        <div class="swiper-slide h-auto">
          <div class="bg-navy text-white rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-integrity-val.png" alt="Integrity" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-white">
              Integrity
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-gray-200">
              We demonstrate empathy and kindness toward every individual while recognizing their inherent worth and dignity.
            </p>
          </div>
        </div>

        <!-- Slide 6: HOPE & HEALING -->
        <div class="swiper-slide h-auto">
          <div class="bg-[#76B2E1] text-navy rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-compassion-val.png" alt="Hope & Healing" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-navy">
              Hope &amp; Healing
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-navy/90 font-medium">
              Restoring faith, physical wellbeing, and emotional comfort to the suffering through comprehensive palliative care.
            </p>
          </div>
        </div>

        <!-- Slide 7: SOCIAL JUSTICE -->
        <div class="swiper-slide h-auto">
          <div class="bg-navy text-white rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-inclusivity-val.png" alt="Social Justice" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-white">
              Social Justice
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-gray-200">
              Advocating for the rights and equitable treatment of destitute children, the elderly, and marginalized communities.
            </p>
          </div>
        </div>

        <!-- Slide 8: EXCELLENCE -->
        <div class="swiper-slide h-auto">
          <div class="bg-[#76B2E1] text-navy rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center h-full min-h-[320px] shadow-md hover:shadow-lg transition-transform duration-300 hover:-translate-y-1">
            <img src="/images/icon-empower-val.png" alt="Excellence in Service" class="w-16 h-16 object-contain mb-5" />
            <h3 class="font-cormorant text-xl sm:text-2xl font-bold uppercase tracking-wider text-navy">
              Excellence
            </h3>
            <p class="font-lato mt-4 text-xs sm:text-sm leading-relaxed text-navy/90 font-medium">
              Upholding the highest standards of professional and compassionate assistance in every rehabilitation initiative.
            </p>
          </div>
        </div>

      </div>

      <div class="swiper-pagination values-pagination !bottom-0"></div>
    </div>

  </div>
</section>

