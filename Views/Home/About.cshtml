<!-- ================= OUR PARTNERS & COLLABORATORS SECTION ================= -->
<section class="relative bg-white overflow-hidden">
  <div class="relative min-h-[380px] sm:min-h-[420px] lg:min-h-[460px] flex items-center">
    <div 
      class="hidden md:block absolute inset-0 bg-cover bg-right bg-no-repeat"
      style="background-image: url('/images/partners-bg.png');"
    ></div>

    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent"></div>

    <img 
      src="/images/partners-bg.png" 
      alt="Hands stacked together in partnership" 
      class="md:hidden w-full h-auto object-cover"
    />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-10 md:py-16 w-full">
      <div class="w-full md:w-[60%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900">
        <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold text-navy leading-tight">
          Our Partners &amp; Collaborators
        </h2>

        <div class="font-lato mt-4 sm:mt-5 space-y-4 text-[#1E1E1E] text-xs sm:text-sm md:text-[15px] leading-relaxed">
          <p>
            The Society welcomes Donors and benefactors, Volunteers, CSR partnerships, Healthcare collaborations, Educational partnerships, Community support initiatives.
          </p>
          <p class="font-bold text-navy text-sm sm:text-base pt-1">
            Together, we can continue building a compassionate and inclusive society.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTTOM STATS BAR -->
