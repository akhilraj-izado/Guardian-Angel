@{
    ViewData["Title"] = "FAQ";
}

<!-- ================= FAQ PAGE HERO SECTION (80VH) ================= -->
<section class="relative bg-[#FAF5EE] overflow-hidden pt-[68px] sm:pt-[76px] md:pt-0 flex flex-col justify-center md:min-h-[80vh] lg:min-h-[100vh]">
  <!-- Background Image (all screen sizes; text sits on top of it) -->
  <div
    class="absolute inset-0 bg-cover bg-right bg-no-repeat"
    style="background-image: url('/images/faq-hero-bg.png');"
    role="img" aria-label="Compassionate caregiver smiling with elderly resident"
  ></div>

  <!-- Cream overlay for readability: strong on mobile (text spans full width), left fade on desktop -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#FAF5EE]/95 via-[#FAF5EE]/80 to-[#FAF5EE]/40 md:from-[#FAF5EE] md:via-[#FAF5EE]/75 md:to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-14 sm:py-16 w-full flex items-center">
    <div class="w-full md:w-[60%] lg:w-[48%]" data-aos="fade-right" data-aos-duration="900">
      <p class="font-cormorant text-sm sm:text-base font-bold uppercase tracking-[0.2em] text-navy">
        FAQ's
      </p>
      <h1 class="font-cormorant mt-2 text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-bold uppercase tracking-wide text-navy leading-[1.2]">
        Frequently Asked<br />Questions
      </h1>
      <p class="font-lato mt-5 text-sm md:text-base leading-relaxed text-[#1E1E1E]/90 max-w-lg">
        Find answers to common questions about our services, volunteering, donations, and how we care for those in need with compassion and dignity.
      </p>
    </div>
  </div>
</section>

<!-- ================= FAQ ACCORDION SECTION ================= -->
<section class="py-12 md:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
    <!-- Top Filter Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 md:mb-12" data-aos="fade-down" data-aos-duration="800">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3" id="faq-tabs">
        <button onclick="switchFaqTab('all')" data-faq-tab="all" class="faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all bg-sky text-white shadow-sm">
          All Questions
        </button>
        <button onclick="switchFaqTab('about')" data-faq-tab="about" class="faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          About Us
        </button>
        <button onclick="switchFaqTab('services')" data-faq-tab="services" class="faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          Our Services
        </button>
        <button onclick="switchFaqTab('volunteering')" data-faq-tab="volunteering" class="faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          Volunteering
        </button>
        <button onclick="switchFaqTab('donations')" data-faq-tab="donations" class="faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          Donations
        </button>
        <button onclick="switchFaqTab('general')" data-faq-tab="general" class="faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky">
          General
        </button>
      </div>

      <div class="relative w-full md:w-72 lg:w-80">
        <input 
          type="text" 
          id="faq-search" 
          onkeyup="filterFaqs()" 
          placeholder="Search Questions" 
          class="w-full pl-5 pr-11 py-2.5 rounded-full border border-gray-300 text-xs sm:text-sm focus:outline-none focus:border-sky font-lato"
        />
        <svg class="w-4 h-4 text-gray-500 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- 2-Column Accordion Grid Container -->
    <div id="faq-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6 items-start">
      
      <!-- Left Column Grid Group -->
      <div class="space-y-4">
        
        <!-- Accordion 1 -->
        <div class="faq-item group rounded-xl border border-sky/40 border-l-4 border-l-sky bg-white shadow-md transition-all overflow-hidden" data-category="about" data-aos="fade-up" data-aos-delay="100">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              What is Guardian Angel Care Charitable Society?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 block">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Guardian Angel Care Charitable Society is a registered non-profit organization established in 1985, dedicated to providing compassionate care, healthcare, education, rehabilitation, and community support to vulnerable individuals and families.
            </p>
          </div>
        </div>

        <!-- Accordion 2 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="services" data-aos="fade-up" data-aos-delay="150">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              What services do you provide?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              We offer comprehensive elder care, specialized mental health rehabilitation, education for children, hospital palliative support, and community welfare programmes across Kerala.
            </p>
          </div>
        </div>

        <!-- Accordion 3 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="services" data-aos="fade-up" data-aos-delay="200">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              Who can benefit from your services?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Vulnerable seniors, destitute individuals, underprivileged students, patients needing end-of-life care, and families experiencing crises irrespective of caste or creed.
            </p>
          </div>
        </div>

        <!-- Accordion 4 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="services" data-aos="fade-up" data-aos-delay="250">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              Are your services free of cost?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Yes, our core humanitarian care, palliative treatments, and shelter for destitute individuals are provided completely free through philanthropic donations.
            </p>
          </div>
        </div>

        <!-- Accordion 5 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="about" data-aos="fade-up" data-aos-delay="300">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              How do you ensure the well-being of those in your care?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              With 100+ dedicated staff, 24/7 medical supervision, hygienic living spaces, healthy meals, and emotional guidance rooted in love and respect.
            </p>
          </div>
        </div>

        <!-- Accordion 6 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="general" data-aos="fade-up" data-aos-delay="350">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              Can I visit or meet someone in your care?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Visitors and family members are welcome during official visiting hours. Prior confirmation with the administrative office helps us ensure safety and tranquility.
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column Grid Group -->
      <div class="space-y-4">
        
        <!-- Accordion 7 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="volunteering" data-aos="fade-up" data-aos-delay="100">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              How can I volunteer with Guardian Angel Care?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              You can fill out the volunteer application form on our website or get in touch directly via our contact number. We accommodate both on-site and remote community roles.
            </p>
          </div>
        </div>

        <!-- Accordion 8 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="volunteering" data-aos="fade-up" data-aos-delay="150">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              What types of volunteer opportunities are available?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Opportunities range from spending recreational time with elderly residents, tutoring children, healthcare camps, food distribution, and administrative assistance.
            </p>
          </div>
        </div>

        <!-- Accordion 9 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="volunteering" data-aos="fade-up" data-aos-delay="200">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              Do I need any special skills to volunteer?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              No special skills are necessary — only compassion, patience, and a willingness to help. Specialized healthcare or teaching skills are an added asset.
            </p>
          </div>
        </div>

        <!-- Accordion 10 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="donations" data-aos="fade-up" data-aos-delay="250">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              How can I make a donation?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Donations can be made securely online via Bank Transfer, UPI, Cheques, or directly visiting our administrative office in Airapuram.
            </p>
          </div>
        </div>

        <!-- Accordion 11 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="donations" data-aos="fade-up" data-aos-delay="300">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              Is my donation tax-deductible?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Yes, all donations are eligible for tax exemption under Section 80G of the Income Tax Act. Official receipts are issued promptly.
            </p>
          </div>
        </div>

        <!-- Accordion 12 -->
        <div class="faq-item rounded-xl border border-[#76B2E1]/40 bg-[#EEF4FF]/50 shadow-sm transition-all overflow-hidden" data-category="donations" data-aos="fade-up" data-aos-delay="350">
          <button onclick="toggleAccordion(this)" class="w-full px-5 py-4 flex items-center justify-between text-left gap-4">
            <span class="font-lato font-bold text-sm sm:text-base text-navy">
              How is my donation used?
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 flex items-center justify-center text-navy text-xl font-bold">
              <svg class="w-5 h-5 minus-icon hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <svg class="w-5 h-5 plus-icon block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </span>
          </button>
          <div class="faq-content px-5 pb-5 hidden">
            <p class="font-lato text-xs sm:text-sm text-navy/80 leading-relaxed">
              Your contribution supports healthcare services, education programmes, rehabilitation initiatives, residential care, and other activities that improve the lives of those we serve.
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- No Search Results Found Message -->
    <p id="no-faq-msg" class="hidden text-center text-gray-500 font-lato py-12">No questions found matching your search.</p>

  </div>
</section>

<!-- ================= STILL HAVE QUESTIONS SECTION ================= -->
<section class="relative bg-[#F9F6F0] overflow-hidden py-14 sm:py-16 md:py-20 lg:py-24" data-aos="fade-in" data-aos-duration="900">
  <div 
    class="hidden md:block absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('/images/still-questions-bg.png');"
  ></div>

  <div class="hidden md:block absolute inset-0 bg-gradient-to-b from-[#F9F6F0]/85 via-[#F9F6F0]/75 to-transparent"></div>

  <img 
    src="/images/still-questions-bg.png" 
    alt="Desk with laptop, notebook and cup" 
    class="md:hidden w-full h-auto object-cover max-h-[260px] mb-6"
  />

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 text-center" data-aos="fade-up" data-aos-delay="150">
    <h2 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-bold uppercase tracking-wider text-navy leading-tight">
      Still Have Questions?
    </h2>

    <p class="font-lato mt-2.5 text-xs sm:text-sm md:text-base text-[#1E1E1E]/90">
      We're here to help you. Reach out to us anytime.
    </p>

    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-12 md:gap-16">
