@section Scripts {
<script>
  let currentFaqTab = 'all';

  // ---- Smooth accordion animation (slide + fade) ----
  const FAQ_ANIM_MS = 350;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Open/closed state lives in data-state once animated; before that, the 'hidden' class tells us.
  function isFaqOpen(el) {
    return el.dataset.state ? el.dataset.state === 'open' : !el.classList.contains('hidden');
  }

  function clearFaqStyles(el) {
    el.style.height = el.style.paddingBottom = el.style.opacity = el.style.overflow = el.style.transition = '';
  }

  function runFaqTransition(el, done) {
    clearTimeout(el._faqTimer);
    el._faqTimer = setTimeout(done, FAQ_ANIM_MS + 50); // timer instead of transitionend: always fires once
  }

  function openFaq(el) {
    if (isFaqOpen(el)) return;
    el.dataset.state = 'open';
    el.classList.remove('hidden');
    if (reduceMotion) { clearFaqStyles(el); return; }

    const target = el.scrollHeight;               // full height incl. bottom padding
    el.style.overflow = 'hidden';
    el.style.transition = 'none';
    el.style.height = '0px';
    el.style.paddingBottom = '0px';
    el.style.opacity = '0';
    el.offsetHeight;                               // force reflow so the start values apply
    el.style.transition = `height ${FAQ_ANIM_MS}ms ease, padding-bottom ${FAQ_ANIM_MS}ms ease, opacity ${FAQ_ANIM_MS}ms ease`;
    el.style.height = target + 'px';
    el.style.paddingBottom = '';
    el.style.opacity = '1';
    runFaqTransition(el, () => { if (el.dataset.state === 'open') clearFaqStyles(el); });
  }

  function closeFaq(el) {
    if (!isFaqOpen(el)) return;
    el.dataset.state = 'closed';
    if (reduceMotion) { el.classList.add('hidden'); clearFaqStyles(el); return; }

    el.style.overflow = 'hidden';
    el.style.transition = 'none';
    el.style.height = el.scrollHeight + 'px';
    el.offsetHeight;
    el.style.transition = `height ${FAQ_ANIM_MS}ms ease, padding-bottom ${FAQ_ANIM_MS}ms ease, opacity ${FAQ_ANIM_MS}ms ease`;
    el.style.height = '0px';
    el.style.paddingBottom = '0px';
    el.style.opacity = '0';
    runFaqTransition(el, () => {
      if (el.dataset.state === 'closed') { el.classList.add('hidden'); clearFaqStyles(el); }
    });
  }

  function toggleAccordion(button) {
    const clickedItem = button.closest('.faq-item');
    const content = clickedItem.querySelector('.faq-content');
    const minusIcon = clickedItem.querySelector('.minus-icon');
    const plusIcon = clickedItem.querySelector('.plus-icon');
    const isCurrentlyOpen = isFaqOpen(content);

    document.querySelectorAll('.faq-item').forEach(item => {
      if (item === clickedItem && !isCurrentlyOpen) return; // about to open; don't close it first
      const c = item.querySelector('.faq-content');
      const minus = item.querySelector('.minus-icon');
      const plus = item.querySelector('.plus-icon');

      closeFaq(c);
      minus.classList.add('hidden');
      plus.classList.remove('hidden');

      item.classList.remove('border-l-4', 'border-l-sky', 'bg-white', 'shadow-md');
      item.classList.add('border-[#76B2E1]/40', 'bg-[#EEF4FF]/50');
    });

    if (!isCurrentlyOpen) {
      openFaq(content);
      minusIcon.classList.remove('hidden');
      plusIcon.classList.add('hidden');

      clickedItem.classList.add('border-l-4', 'border-l-sky', 'bg-white', 'shadow-md');
      clickedItem.classList.remove('bg-[#EEF4FF]/50');
    }

    // Refresh layout positions once the slide has finished
    if (typeof AOS !== 'undefined') {
      setTimeout(() => AOS.refresh(), reduceMotion ? 0 : FAQ_ANIM_MS + 60);
    }
  }

  function switchFaqTab(category) {
    currentFaqTab = category;

    document.querySelectorAll('.faq-tab-btn').forEach(btn => {
      if (btn.dataset.faqTab === category) {
        btn.className = "faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all bg-sky text-white shadow-sm";
      } else {
        btn.className = "faq-tab-btn font-lato px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all text-navy hover:text-sky";
      }
    });

    filterFaqs();
  }

  function filterFaqs() {
    const query = document.getElementById('faq-search').value.toLowerCase().trim();
    const items = document.querySelectorAll('.faq-item');
    let visibleCount = 0;

    items.forEach(item => {
      const itemCat = item.dataset.category;
      const itemText = item.innerText.toLowerCase();

      const matchesTab = (currentFaqTab === 'all' || itemCat === currentFaqTab);
      const matchesSearch = itemText.includes(query);

      if (matchesTab && matchesSearch) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    const noMsg = document.getElementById('no-faq-msg');
    if (noMsg) {
      if (visibleCount === 0) {
        noMsg.classList.remove('hidden');
      } else {
        noMsg.classList.add('hidden');
      }
    }

    // Refresh layout positions on tab filtering
    if (typeof AOS !== 'undefined') {
      AOS.refresh();
    }
  }
</script>
}
