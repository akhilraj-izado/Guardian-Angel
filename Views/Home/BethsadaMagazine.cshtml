@{
    ViewData["Title"] = "Bethsada Magazine";
}

<!-- ================= BETHSADA MAGAZINE HERO SECTION ================= -->
<section class="relative bg-white md:min-h-[75vh] lg:min-h-[88vh] overflow-hidden">

    <!-- Desktop / Tablet Background Image -->
    <div class="hidden md:block absolute inset-0 bg-cover bg-center bg-no-repeat"
         style="background-image: url('/images/bethsada-magazine-hero.png');"
         data-aos="fade-in"
         data-aos-duration="1200"></div>

    <!-- Soft light wash on the left so the text stays readable -->
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-white/50 via-white/15 to-transparent pointer-events-none"></div>

    <!-- Mobile Top Image -->
    <img src="/images/bethsada-magazine-hero.png"
         alt="Open magazines stacked on a wooden desk beside a notebook and pencils"
         class="md:hidden w-full h-auto object-cover" />

    <!-- Main Content (sits in the upper-left, below the overlay header) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-8 pb-12 md:pt-36 lg:pt-44 md:pb-24">
        <div class="w-full md:w-[55%] lg:w-[46%]" data-aos="fade-right" data-aos-duration="900" data-aos-delay="200">

            <h1 class="font-cormorant text-2xl sm:text-3xl md:text-4xl lg:text-[44px] font-semibold uppercase tracking-wide text-navy leading-[1.25]">
                Bethsada Magazine
            </h1>

            <p class="font-lato mt-4 md:mt-5 text-sm sm:text-[15px] md:text-base font-bold italic text-[#5E6B7A] leading-relaxed">
                A Platform for Creativity, Knowledge, and Inspiration
            </p>

            <p class="font-lato mt-4 md:mt-5 text-sm sm:text-[15px] md:text-base text-[#4A5568] leading-relaxed max-w-xl">
                This is a small publishing house that has successfully published and released a few books in the past on varied topics like Psychology, Spirituality and even Humor. Publication of a monthly named ‘Guardian Angel Magazine’ carrying articles concentrating on maintaining Christian values in our day-to-day life is the main activity now.
            </p>

        </div>
    </div>

</section>

<!-- ================= SCRIPTURE QUOTE BANNER (GREEN GRADIENT) ================= -->
<section class="bg-gradient-to-r from-[#3F6418] via-[#5A8A26] to-[#7DB238] py-5 sm:py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10" data-aos="fade-up" data-aos-duration="900">
        <p class="font-cormorant text-xl sm:text-2xl md:text-3xl lg:text-[34px] font-semibold text-white text-center leading-snug">
            “For we cannot help speaking about what we have seen and heard.” (Acts 4:20)
        </p>
    </div>
</section>

<!-- ================= EMPOWERING CREATIVITY (RIGHT BLEED, LEFT CURVE) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 overflow-hidden">
    <div class="w-full flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Content Column -->
        <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pl-12 xl:pl-24" data-aos="fade-right" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-5">
                    Empowering Creativity and<br class="hidden sm:block" />
                    Giving Voice to Every Talent
                </h2>
                <div class="font-lato space-y-5 text-sm sm:text-[15px] md:text-base text-[#5E6B7A] leading-relaxed">
                    <p>
                        Bethsada Magazine is a unique publication of the Guardian Angel Care Charitable Society, created with the vision of encouraging creativity, self-expression, and awareness among children, students, and members of the wider community. The magazine serves as a vibrant platform where ideas, talents, and experiences are shared through meaningful and engaging content.
                    </p>
                    <p>
                        The initiative was born from the realization that many talented individuals lacked opportunities to express their thoughts and creative abilities. Inspired by the need to provide a voice for the unheard and a stage for emerging talent, Bethsada Magazine was established on the values of inclusivity, empowerment, education, and cultural enrichment. From its humble beginnings, the magazine has grown steadily through the collective efforts of educators, volunteers, coordinators, writers, and supporters of the Guardian Angel Care Charitable Society. Despite challenges such as limited resources and lack of publishing experience during the initial stages, the dedication and teamwork of committed individuals helped transform the vision into a successful and appreciated publication.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Image: Bleeds to Right Screen Edge with Rounded Left End -->
        <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-left" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[380px] lg:h-[400px] xl:h-[420px] rounded-l-full overflow-hidden">
                <img src="/images/bethsada-magazine-team.png"
                     alt="Teachers, a nun and students reading an issue of Bethsada Magazine together in the library"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

    </div>
</section>

<!-- ================= CONTENT FEATURES (7 ICON BOXES) ================= -->
<section class="bg-white py-12 sm:py-14 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10">

        <h2 class="font-cormorant text-2xl sm:text-3xl lg:text-[38px] font-semibold text-navy leading-tight mb-8" data-aos="fade-up" data-aos-duration="900">
            Bethsada Magazine features a wide range of content including:
        </h2>

        <!-- 4 boxes on the first row, 3 centred on the second (desktop) -->
        <ul class="flex flex-wrap justify-center gap-4 lg:gap-x-6 xl:gap-x-11 lg:gap-y-6" data-aos="fade-up" data-aos-duration="900" data-aos-delay="150">

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[214px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-poems-stories.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Poems and short stories</span>
            </li>

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[214px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-essays-memoirs.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Reflective essays and memoirs</span>
            </li>

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[214px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-health-wellness.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Health and wellness articles</span>
            </li>

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[214px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-spiritual-reflections.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Spiritual reflections</span>
            </li>

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[246px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-book-reviews.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Book reviews and educational content</span>
            </li>

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[236px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-creative-works.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Drawings, creative works, and entertainment features</span>
            </li>

            <li class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[246px] bg-[#D8EEFF] rounded-lg flex items-center gap-3 px-4 py-4 min-h-[96px] group">
                <img src="/images/icon-bm-interviews.png" alt="" class="w-16 h-14 object-contain shrink-0 mix-blend-multiply transition-transform duration-300 group-hover:scale-110" />
                <span class="font-lato text-sm text-navy leading-snug">Interviews with distinguished personalities and short stories</span>
            </li>

        </ul>
    </div>
</section>

<!-- ================= RECOGNITION, CONTRIBUTIONS & GROWTH (LEFT BLEED, RIGHT CURVE) ================= -->
<section class="bg-[#FAF0DE] py-14 sm:py-16 overflow-hidden">
    <div class="w-full flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-14">

        <!-- Left Image: Bleeds to Left Screen Edge with Rounded Right End -->
        <div class="w-full lg:w-[54%] shrink-0" data-aos="fade-right" data-aos-duration="900">
            <div class="w-full h-64 sm:h-80 md:h-[380px] lg:h-[380px] xl:h-[400px] rounded-r-full overflow-hidden">
                <img src="/images/bethsada-magazine-recognition.png"
                     alt="An open copy of Bethsada Magazine on a wooden desk with a notebook and a stack of issues"
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
        </div>

        <!-- Right Content Column -->
        <div class="w-full lg:w-[46%] px-4 sm:px-6 lg:px-0 lg:pr-12 xl:pr-24" data-aos="fade-left" data-aos-duration="900" data-aos-delay="150">
            <div class="max-w-xl">
                <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[40px] font-semibold text-navy leading-tight mb-5">
                    Recognition, Contributions &amp;<br class="hidden sm:block" />
                    Continued Growth
                </h2>
                <div class="font-lato space-y-5 text-sm sm:text-[15px] md:text-base text-[#5E6B7A] leading-relaxed">
                    <p>
                        The magazine has earned appreciation for its thoughtfully curated articles, attractive presentation, and meaningful themes. Contributions from writers, educators, students, &amp; community members make each edition rich, diverse, and inspiring. Articles by Fr. Shibu Cheriyan and special features on unique topics such as the history of Air India, comics, and tea have received notable recognition from readers.
                    </p>
                    <p>
                        Supported by donors, well-wishers, and volunteers, Bethsada Magazine continues to grow in quality and reach. Financial and voluntary contributions have played an important role in ensuring regular publication and wider participation.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>
