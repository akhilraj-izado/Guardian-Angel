<!-- ================= JAVASCRIPT LOGIC ================= -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
      // Desktop Mega Menu Toggle on Click
      const projectBtn = document.getElementById('projectDropdownBtn');
      const projectMenu = document.getElementById('projectMegaMenu');
      const projectArrow = document.getElementById('projectDropdownArrow');
      const projectContainer = document.getElementById('projectDropdownContainer');

      if (projectBtn && projectMenu) {
        projectBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          const isOpen = projectMenu.classList.toggle('mega-menu-open');
          if (projectArrow) {
            projectArrow.classList.toggle('arrow-rotate', isOpen);
          }
        });

        // Close mega menu when clicking outside
        document.addEventListener('click', function (e) {
          if (!projectContainer.contains(e.target)) {
            projectMenu.classList.remove('mega-menu-open');
            if (projectArrow) {
              projectArrow.classList.remove('arrow-rotate');
            }
          }
        });
      }

      // Sticky header: add a shadow once the page has scrolled
      const siteHeader = document.getElementById('siteHeader');
      if (siteHeader) {
        const onScroll = function () { siteHeader.classList.toggle('shadow-md', window.scrollY > 10); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Mobile hamburger toggle is handled in /js/main.js (binding it here too made the menu open and close on the same click).

      // Mobile Projects Accordion Dropdown Toggle
      const mobileProjectsBtn = document.getElementById('mobileProjectsBtn');
      const mobileProjectsList = document.getElementById('mobileProjectsList');
      const mobileProjectsArrow = document.getElementById('mobileProjectsArrow');

      if (mobileProjectsBtn && mobileProjectsList) {
        mobileProjectsBtn.addEventListener('click', function () {
          const isListHidden = mobileProjectsList.classList.toggle('hidden');
          if (mobileProjectsArrow) {
            mobileProjectsArrow.classList.toggle('rotate-180', !isListHidden);
          }
        });
      }
    });
</script>