<header class="absolute top-0 left-0 w-full z-50 bg-white transition-all duration-300 @ViewData["HeaderClass"]" data-aos="fade-down" data-aos-duration="600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-4 flex items-center justify-between">
      
      <!-- Logo -->
      <a href="/" class="shrink-0">
        <img src="/images/logo.png" alt="Guardian Angel Care" class="h-9 sm:h-11 w-auto" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-8 text-xs lg:text-sm font-bold tracking-wide uppercase text-navy/80">
        <a href="/" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">Home</a>
        <a href="/about" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">About Us</a>
        <a href="/ourgoals" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">Our Goals</a>
        <a href="/project" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">Projects</a>
        <a href="/blog" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">Blogs</a>
        <a href="/gallery" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">Gallery</a>
        <a href="/faq" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">FAQ</a>
        <a href="/contact" class="nav-link pb-1 border-b-2 border-transparent transition-colors hover:text-sky">Contact</a>
      </nav>

      <!-- Mobile menu button -->
      <button id="menuBtn" class="md:hidden p-2 rounded text-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-sky" aria-label="Open menu" aria-expanded="false">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav id="mobileMenu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg px-6 py-4 space-y-3 text-sm font-bold uppercase text-navy/80">
      <a href="/" class="mobile-nav-link block transition-colors hover:text-sky">Home</a>
      <a href="/about" class="mobile-nav-link block transition-colors hover:text-sky">About Us</a>
      <a href="/ourgoals" class="mobile-nav-link block transition-colors hover:text-sky">Our Goals</a>
      <a href="/project" class="mobile-nav-link block transition-colors hover:text-sky">Projects</a>
      <a href="/blog" class="mobile-nav-link block transition-colors hover:text-sky">Blogs</a>
      <a href="/gallery" class="mobile-nav-link block transition-colors hover:text-sky">Gallery</a>
      <a href="/faq" class="mobile-nav-link block transition-colors hover:text-sky">FAQ</a>
      <a href="/contact" class="mobile-nav-link block transition-colors hover:text-sky">Contact</a>
    </nav>
